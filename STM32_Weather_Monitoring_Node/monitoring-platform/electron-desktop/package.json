{
  "name": "weather-monitoring-app",
  "version": "1.0.0",
  "main": "index.js",
  "description": "天气监测节点 - 独立桌面前端 (连接远程后端服务)",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.weather.monitoring",
    "productName": "weather-monitoring-app",
    "files": [
      "index.js"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
}