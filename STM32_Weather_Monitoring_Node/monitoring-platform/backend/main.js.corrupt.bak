const mqtt = require('mqtt');
const sqlite3 = require('sqlite3').verbose();
const express = require('express');
const cors = require('cors');
const path = require('path');
const http = require('http');
const {
    Server
} = require('socket.io');

// ========== 閰嶇疆 ==========
const MQTT_BROKER = 'mqtt://8.130.191.142:1883';
const MQTT_TOPIC = 'IOTGP/WMN';
const DB_PATH = path.join(__dirname, 'weather.db');
const HTTP_PORT = 3000;
const CLEANUP_INTERVAL_HOURS = 72;
const PRESSURE_HISTORY_SIZE = 30; // 鐢ㄤ簬澶ф皵鍘嬮娴嬬殑鍘嗗彶鏁版嵁鐐规暟

// ========== 鍏ㄥ眬鍙橀噺 ==========
let pressureHistory = []; // 杩戞湡澶ф皵鍘嬪巻鍙?{ time, pressure }
let lastHWPacket = null;

// ========== 鏁版嵁搴撳垵濮嬪寲 ==========
const db = new sqlite3.Database(DB_PATH, (err) => {
            if (err) {
                console.error('[DB] 鎵撳紑鏁版嵁搴撳け璐?', err.message);
                process.exit(1);
            }
            console.log('[DB] 宸茶繛鎺ュ埌 SQLite 鏁版嵁搴?);
            });

        db.serialize(() => {
            db.run(`CREATE TABLE IF NOT EXISTS weather_data (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    clientid TEXT,
    uptime INTEGER,
    time TEXT,
    dht11_temp REAL,
    dht11_humidity REAL,
    bmp280_pressure REAL,
    bmp280_temp REAL,
    is_rain INTEGER,
    is_night INTEGER,
    weather_prediction INTEGER,
    oled_power INTEGER,
    pt_voltage REAL,
    battery_voltage REAL,
    light_mv REAL,
    sw_pressure_prediction INTEGER,
    created_at INTEGER
  )`, (err) => {
                if (err) console.error('[DB] 鍒涘缓琛ㄥけ璐?', err.message);
            });

            // 鍒涘缓绱㈠紩
            db.run(`CREATE INDEX IF NOT EXISTS idx_time ON weather_data(time)`);
            db.run(`CREATE INDEX IF NOT EXISTS idx_created_at ON weather_data(created_at)`);
        });

        // ========== 澶ф皵鍘嬮娴嬬畻娉?==========
        // 0=杞櫞澶?1=杞檷闆ㄥ埉椋?2=杞槾澶?3=杞浄鏆村己瀵规祦 4=鏃犳晥棰勬祴
        function predictByPressure(currentPressure, bmp280Temp) {
            if (pressureHistory.length < 5) return 4; // 鏁版嵁涓嶈冻

            // 璁＄畻鍘嬪姏鍙樺寲瓒嬪娍
            const pressures = pressureHistory.map(p => p.pressure);
            const n = pressures.length;

            // 绾挎€у洖褰掕绠楁枩鐜?(Pa per sample)
            let sumX = 0,
                sumY = 0,
                sumXY = 0,
                sumXX = 0;
            for (let i = 0; i < n; i++) {
                sumX += i;
                sumY += pressures[i];
                sumXY += i * pressures[i];
                sumXX += i * i;
            }
            const slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);

            // 璁＄畻鍙樺寲骞呭害锛堢浉瀵逛簬骞冲潎鍊肩殑鐧惧垎姣旓級
            const avgP = pressures.reduce((a, b) => a + b, 0) / n;
            const totalChange = currentPressure - pressures[0];
            const changePercent = (totalChange / avgP) * 100;

            // 璁＄畻鐭湡鍙樺寲锛堟渶杩?涓偣锛?
            const recentN = Math.min(3, n);
            const recentPressures = pressures.slice(-recentN);
            const recentAvg = recentPressures.reduce((a, b) => a + b, 0) / recentN;
            const recentChange = currentPressure - recentPressures[0];
            const recentChangePercent = (recentChange / recentAvg) * 100;

            // 璁＄畻娉㈠姩鐜?
            let variance = 0;
            for (const p of pressures) {
                variance += (p - avgP) ** 2;
            }
            variance /= n;
            const stdDev = Math.sqrt(variance);
            const volatility = (stdDev / avgP) * 1000; // 鍗冨垎姣?

            // 鏍囧噯澶ф皵鍘嬪弬鑰?101325 Pa
            const pressureLevel = currentPressure / 101325;

            // 棰勬祴閫昏緫
            // 蹇€熶笅闄?+ 浣庢皵鍘?-> 闆锋毚/寮哄娴?
            if (slope < -15 && recentChangePercent < -0.08 && pressureLevel < 0.995) {
                return 3;
            }

            // 涓瓑涓嬮檷 -> 闄嶉洦鍒
            if (slope < -8 && recentChangePercent < -0.04) {
                return 1;
            }

            // 缂撴參涓嬮檷鎴栦綆姘斿帇涓旀箍搴﹂珮(閫氳繃娓╁害闂存帴鍒ゆ柇) -> 闃村ぉ
            if (slope < -3 || (pressureLevel < 0.998 && bmp280Temp < 20)) {
                return 2;
            }

            // 绋冲畾涓婂崌鎴栭珮姘斿帇 -> 杞櫞澶?
            if (slope > 5 || (pressureLevel > 1.005 && recentChangePercent > 0.02)) {
                return 0;
            }

            // 鍘嬪姏澶у箙娉㈠姩 -> 闆锋毚鍙兘鎬?
            if (volatility > 0.8 && recentChangePercent < -0.03) {
                return 3;
            }

            // 鍘嬪姏鎸佺画绋冲畾 -> 鏅?闃存牴鎹綋鍓嶆皵鍘嬪垽鏂?
            if (Math.abs(slope) < 2 && volatility < 0.3) {
                return pressureLevel >= 1.0 ? 0 : 2;
            }

            return 4;
        }

        // ========== MQTT 杩炴帴 ==========
        const mqttClient = mqtt.connect(MQTT_BROKER, {
            reconnectPeriod: 5000,
            connectTimeout: 10000,
            clientId: 'monitoring_platform_' + Math.random().toString(16).substr(2, 8)
        });

        mqttClient.on('connect', () => {
            console.log('[MQTT] 宸茶繛鎺ュ埌 Broker:', MQTT_BROKER);
            mqttClient.subscribe(MQTT_TOPIC, (err) => {
                if (err) {
                    console.error('[MQTT] 璁㈤槄澶辫触:', err);
                } else {
                    console.log('[MQTT] 宸茶闃呬富棰?', MQTT_TOPIC);
                }
            });
        });

        mqttClient.on('reconnect', () => {
            console.log('[MQTT] 姝ｅ湪閲嶈繛...');
        });

        mqttClient.on('error', (err) => {
            console.error('[MQTT] 閿欒:', err.message);
        });

        mqttClient.on('message', (topic, message) => {
            try {
                const payload = message.toString();
                const data = JSON.parse(payload);
                handleWeatherData(data);
            } catch (e) {
                console.error('[MQTT] 瑙ｆ瀽娑堟伅澶辫触:', e.message, message.toString().substr(0, 200));
            }
        });

        function handleWeatherData(data) {
            // 鏇存柊澶ф皵鍘嬪巻鍙?
            if (typeof data.bmp280_pressure === 'number' && data.bmp280_pressure > 0) {
                pressureHistory.push({
                    time: data.time || new Date().toISOString(),
                    pressure: data.bmp280_pressure
                });
                if (pressureHistory.length > PRESSURE_HISTORY_SIZE) {
                    pressureHistory.shift();
                }
            }

            // 璁＄畻杞欢棰勬祴
            const swPressurePrediction = predictByPressure(
                data.bmp280_pressure || 0,
                data.bmp280_temp || 0
            );

            const now = Date.now();
            const stmt = db.prepare(`INSERT INTO weather_data (
    clientid, uptime, time, dht11_temp, dht11_humidity,
    bmp280_pressure, bmp280_temp, is_rain, is_night,
    weather_prediction, oled_power, pt_voltage, battery_voltage,
    light_mv, sw_pressure_prediction, created_at
  ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`);

            stmt.run(
                data.clientid || null,
                data.uptime || 0,
                data.time || new Date().toISOString(),
                data.dht11_temp || 0,
                data.dht11_humidity || 0,
                data.bmp280_pressure || 0,
                data.bmp280_temp || 0,
                data.is_rain ? 1 : 0,
                data.is_night ? 1 : 0,
                data.weather_prediction ? ? 4,
                data.oled_power ? 1 : 0,
                data.pt_voltage || 0,
                data.battery_voltage || 0,
                data.light_mv || 0,
                swPressurePrediction,
                now,
                function (err) {
                    if (err) {
                        console.error('[DB] 鎻掑叆鏁版嵁澶辫触:', err.message);
                    }
                }
            );
            stmt.finalize();

            // 淇濆瓨鏈€鏂版暟鎹寘鐢ㄤ簬骞挎挱
            lastHWPacket = {
                ...data,
                sw_pressure_prediction: swPressurePrediction,
                _created_at: now
            };

            // 閫氳繃 Socket.IO 骞挎挱
            if (io) {
                io.emit('weather_data', lastHWPacket);
            }

            console.log('[DATA]', data.time, 'DHT:', data.dht11_temp + '掳C/' + data.dht11_humidity + '%',
                'BMP:', data.bmp280_pressure + 'Pa', 'SW棰勬祴:', swPressurePrediction);
        }

        // ========== 72灏忔椂鏁版嵁搴撴竻鐞?==========
        function runCleanup() {
            const cutoff = Date.now() - CLEANUP_INTERVAL_HOURS * 60 * 60 * 1000;
            db.run(`DELETE FROM weather_data WHERE created_at < ?`, [cutoff], function (err) {
                if (err) {
                    console.error('[DB] 娓呯悊澶辫触:', err.message);
                } else {
                    console.log(`[DB] 宸叉竻鐞?${this.changes} 鏉℃棫璁板綍 (淇濈暀鏈€杩?${CLEANUP_INTERVAL_HOURS}h)`);
                }
            });
            // 鍚屾椂娓呯悊杩囨湡鐨勫ぇ姘斿帇鍘嗗彶
            const pressureCutoff = Date.now() - 2 * 60 * 60 * 1000; // 鍙繚鐣?灏忔椂鐨勫帇鍔涘巻鍙?
            pressureHistory = pressureHistory.filter(p => {
                const t = new Date(p.time).getTime();
                return isNaN(t) || t > pressureCutoff;
            });
        }

        // 鍚姩鏃剁珛鍗虫竻鐞嗕竴娆?
        runCleanup();
        // 姣忓皬鏃舵鏌ヤ竴娆?
        setInterval(runCleanup, 60 * 60 * 1000);

        // ========== HTTP 鏈嶅姟鍣?+ Socket.IO ==========
        const app = express(); app.use(cors()); app.use(express.json()); app.use(express.static(path.join(__dirname, '..', 'web')));

        const server = http.createServer(app);
        const io = new Server(server, {
            cors: {
                origin: '*'
            }
        });

        // ---- API 璺敱 ----

        // 鑾峰彇鏈€鏂颁竴鏉℃暟鎹?
        app.get('/api/latest', (req, res) => {
            db.get(`SELECT * FROM weather_data ORDER BY id DESC LIMIT 1`, (err, row) => {
                if (err) {
                    res.status(500).json({
                        error: err.message
                    });
                } else {
                    res.json(row || {
                        message: 'no data'
                    });
                }
            });
        });

        // 鑾峰彇鍘嗗彶鏁版嵁 (榛樿鏈€杩?灏忔椂锛屾渶澶?4灏忔椂)
        app.get('/api/history', (req, res) => {
            const hours = Math.min(parseFloat(req.query.hours) || 1, 24);
            const limit = parseInt(req.query.limit) || 500;
            const since = Date.now() - hours * 60 * 60 * 1000;

            db.all(
                `SELECT * FROM weather_data WHERE created_at >= ? ORDER BY id ASC LIMIT ?`,
                [since, limit],
                (err, rows) => {
                    if (err) {
                        res.status(500).json({
                            error: err.message
                        });
                    } else {
                        res.json(rows);
                    }
                }
            );
        });

        // 鑾峰彇鏁版嵁缁熻
        app.get('/api/stats', (req, res) => {
            const hours = Math.min(parseFloat(req.query.hours) || 1, 24);
            const since = Date.now() - hours * 60 * 60 * 1000;

            db.get(
                `SELECT
      COUNT(*) as count,
      MIN(dht11_temp) as temp_min, MAX(dht11_temp) as temp_max, AVG(dht11_temp) as temp_avg,
      MIN(dht11_humidity) as hum_min, MAX(dht11_humidity) as hum_max, AVG(dht11_humidity) as hum_avg,
      MIN(bmp280_pressure) as pres_min, MAX(bmp280_pressure) as pres_max, AVG(bmp280_pressure) as pres_avg,
      MIN(battery_voltage) as batt_min, MAX(battery_voltage) as batt_max, AVG(battery_voltage) as batt_avg,
      MIN(light_mv) as light_min, MAX(light_mv) as light_max, AVG(light_mv) as light_avg,
      SUM(is_rain) as rain_count
     FROM weather_data WHERE created_at >= ?`,
                [since],
                (err, row) => {
                    if (err) {
                        res.status(500).json({
                            error: err.message
                        });
                    } else {
                        res.json(row);
                    }
                }
            );
        });

        // 鑾峰彇MQTT杩炴帴鐘舵€?
        app.get('/api/status', (req, res) => {
            res.json({
                mqtt_connected: mqttClient.connected,
                mqtt_broker: MQTT_BROKER,
                mqtt_topic: MQTT_TOPIC,
                records_in_history: pressureHistory.length,
                last_packet_time: lastHWPacket ? lastHWPacket.time : null,
                db_path: DB_PATH,
                cleanup_interval_hours: CLEANUP_INTERVAL_HOURS,
                server_time: new Date().toISOString()
            });
        });

        // ---- Socket.IO ----
        io.on('connection', (socket) => {
            const clientAddr = socket.handshake.address;
            console.log('[WS] 瀹㈡埛绔凡杩炴帴:', clientAddr, '鎬昏繛鎺ユ暟:', io.engine.clientsCount);

            // 绔嬪嵆鎺ㄩ€佹渶鏂版暟鎹?
            if (lastHWPacket) {
                socket.emit('weather_data', lastHWPacket);
            }

            socket.on('disconnect', () => {
                console.log('[WS] 瀹㈡埛绔凡鏂紑:', clientAddr, '鍓╀綑杩炴帴鏁?', io.engine.clientsCount);
            });
        });

        // ========== 鍚姩 ==========
        server.listen(HTTP_PORT, () => {
            console.log('========================================');
            // console.log('   澶╂皵鐩戞祴骞冲彴鍚庣宸插惎鍔?);
            console.log('========================================');
            console.log('  HTTP/Web 鏈嶅姟:   http://localhost:' + HTTP_PORT);
            console.log('  Socket.IO:       ws://localhost:' + HTTP_PORT);
            console.log('  MQTT Broker:     ' + MQTT_BROKER);
            console.log('  MQTT 涓婚:       ' + MQTT_TOPIC);
            console.log('  鏁版嵁搴撴枃浠?      ' + DB_PATH);
            console.log('  鏁版嵁淇濈暀鍛ㄦ湡:    ' + CLEANUP_INTERVAL_HOURS + ' 灏忔椂');
            console.log('========================================');
        });

        // ========== 浼橀泤鍏抽棴 ==========
        let shuttingDown = false;

        function shutdown(signal) {
            if (shuttingDown) return;
            shuttingDown = true;
            console.log('\n[绯荤粺] 姝ｅ湪鍏抽棴... (淇″彿: ' + signal + ')');
            try {
                mqttClient.end(true);
            } catch (e) {}
            db.close(() => {
                    server.close(() => {
                            console.log('[绯荤粺] 宸查€€鍑?);
                                try {
                                    if (process.connected) process.disconnect();
                                } catch (e) {}
                                process.exit(0);
                            });
                        // 鍏滃簳 3 绉掑己鍒堕€€鍑?
                        setTimeout(() => {
                            try {
                                if (process.connected) process.disconnect();
                            } catch (e) {}
                            process.exit(0);
                        }, 3000);
                    });
            }

            process.on('SIGINT', () => shutdown('SIGINT'));
            process.on('SIGTERM', () => shutdown('SIGTERM'));
            // Electron 瀛愯繘绋嬫柇寮€ IPC 鏃堕€€鍑?
            process.on('disconnect', () => shutdown('DISCONNECT'));
            // 鐖惰繘绋?IPC 閫氶亾鍏抽棴鏃朵篃閫€鍑?
            process.on('message', (msg) => {
                if (msg === 'shutdown') shutdown('IPC_SHUTDOWN');
            });