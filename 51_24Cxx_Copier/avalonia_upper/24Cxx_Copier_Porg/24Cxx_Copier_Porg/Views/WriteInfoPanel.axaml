<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:_24Cxx_Copier_Porg.ViewModels"
             mc:Ignorable="d" d:DesignWidth="260"
             x:Class="_24Cxx_Copier_Porg.Views.WriteInfoPanel"
             x:DataType="vm:OpearationPanelViewModel">

    <!-- Reserved "Write Info" control. The DataContext for the inner content is
         the WriteInfoViewModel exposed by the panel view-model. -->
    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="7"
            Padding="12">
        <StackPanel Spacing="6" DataContext="{Binding WriteInfo}">

            <TextBlock Text="Write Info"
                       FontSize="11"
                       FontWeight="SemiBold"/>

            <Separator Opacity="0.5"/>

            <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="Chip model" FontSize="10" Opacity="0.7"/>
                <TextBlock Grid.Column="1" Text="{Binding ChipNameText}"
                           FontSize="10" FontWeight="SemiBold"/>
            </Grid>

            <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="Address range" FontSize="10" Opacity="0.7"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ChipRangeText, Mode=OneWay}"
                         IsReadOnly="True"
                         FontSize="10"
                         Padding="4,2"
                         MinHeight="22"
                         CornerRadius="4"
                         FontFamily="Consolas,Menlo,Monospace"/>
            </Grid>

            <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="Capacity" FontSize="10" Opacity="0.7"/>
                <TextBlock Grid.Column="1" Text="{Binding CapacityText}" FontSize="10"/>
            </Grid>

            <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="Write size" FontSize="10" Opacity="0.7"/>
                <TextBlock Grid.Column="1" Text="{Binding WriteSizeText}" FontSize="10"/>
            </Grid>

            <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="Write range" FontSize="10" Opacity="0.7"/>
                <TextBox Grid.Column="1"
                         Text="{Binding WriteRangeText, Mode=OneWay}"
                         IsReadOnly="False"
                         FontSize="10"
                         Padding="4,2"
                         MinHeight="22"
                         CornerRadius="4"
                         FontFamily="Consolas,Menlo,Monospace"/>
            </Grid>

            <Grid ColumnDefinitions="96,*,Auto">
                <TextBlock Grid.Column="0" Text="Overflow" FontSize="10" Opacity="0.7"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding OverflowText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Image Grid.Column="2"
                       Source="{Binding OverflowAsset}"
                       Width="16" Height="16"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"/>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
