<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:_24Cxx_Copier_Porg.ViewModels"
             mc:Ignorable="d" d:DesignWidth="260"
             x:Class="_24Cxx_Copier_Porg.Views.ChipSelector"
             x:DataType="vm:OpearationPanelViewModel">

    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="7"
            Padding="12">
        <StackPanel Spacing="7">

            <TextBlock Text="Chip Model"
                       FontSize="11"
                       FontWeight="SemiBold"/>

            <Separator Opacity="0.5"/>

            <!-- Chip drop-down: item = model name + muted capacity / address range -->
            <ComboBox ItemsSource="{Binding ChipModels}"
                      SelectedItem="{Binding SelectedChip}"
                      HorizontalAlignment="Stretch"
                      FontSize="11">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:ChipModelViewModel">
                        <StackPanel Margin="2,1">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="11"/>
                            <TextBlock Text="{Binding CapacityText}"
                                       FontSize="9"
                                       Opacity="0.65"/>
                            <TextBlock Text="{Binding AddressRangeText}"
                                       FontSize="9"
                                       Opacity="0.65"
                                       FontFamily="Consolas,Menlo,Monospace"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

        </StackPanel>
    </Border>
</UserControl>
