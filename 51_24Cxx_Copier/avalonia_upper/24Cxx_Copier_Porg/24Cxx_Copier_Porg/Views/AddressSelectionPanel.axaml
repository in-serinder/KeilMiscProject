<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:_24Cxx_Copier_Porg.ViewModels"
             xmlns:views="using:_24Cxx_Copier_Porg.Views"
             mc:Ignorable="d" d:DesignWidth="500"
             x:Class="_24Cxx_Copier_Porg.Views.AddressSelectionPanel"
             x:DataType="vm:OpearationPanelViewModel">

    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="7"
            Padding="12">
        <DockPanel LastChildFill="True">

            <!-- Header -->
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,7">
                <TextBlock Grid.Column="0"
                           Text="Target Addresses"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Select all"
                            FontSize="9"
                            Padding="7,3"
                            Command="{Binding SelectAllCommand}"/>
                    <Button Content="Clear"
                            FontSize="9"
                            Padding="7,3"
                            Command="{Binding DeselectAllCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Column hint row -->
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Text="Enabled" FontSize="8"
                           Opacity="0.7" Margin="0,0,9,0"/>
                <TextBlock Grid.Column="1" Text="Progress" FontSize="8" Opacity="0.7"/>
                <TextBlock Grid.Column="2" Text="Done" FontSize="8" Opacity="0.7"
                           MinWidth="34" TextAlignment="Right" Margin="9,0,9,0"/>
                <TextBlock Grid.Column="3" Text="Address" FontSize="8" Opacity="0.7"
                           Width="62" TextAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Read" FontSize="8" Opacity="0.7"
                           Width="24" TextAlignment="Center" Margin="6,0,0,0"/>
            </Grid>

            <Separator DockPanel.Dock="Top" Margin="0,0,0,3" Opacity="0.5"/>

            <!-- Address rows with a separator between each entry -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AddressSlots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AddressSlotViewModel">
                            <StackPanel>
                                <views:AddressSlotRow Margin="0,4"/>
                                <Separator Opacity="0.35"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

