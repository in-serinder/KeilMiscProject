<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Capsa.ViewModels.Editors"
             xmlns:models="using:Capsa.Models"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="360"
             x:Class="Capsa.Views.Editors.TextEditorView"
             x:DataType="vm:EditorSessionViewModel">

    <Grid RowDefinitions="*,Auto">

        <!-- 纯文本编辑区：左侧行号栏 + 编辑器（行号与滚动同步） -->
        <Border Grid.Row="0"
                Background="{DynamicResource Capsa.EditorBg}"
                ClipToBounds="True">
            <Grid ColumnDefinitions="Auto,*">

                <!-- 行号栏：等宽字体与编辑器一致。
                     ★ 必须包在 ScrollViewer 里 —— 没有滚动容器时 TextBlock 的
                     measure 高度被限制为可视区，长内容只布局/渲染前十几行
                     （这就是"超过 18 行没有行标"的原因）。
                     编辑器滚动时直接把 Offset 写进这个 ScrollViewer。 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Capsa.SurfaceAlt}"
                        BorderBrush="{DynamicResource Capsa.Border}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">
                    <ScrollViewer x:Name="GutterScroll"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="GutterText"
                                   Margin="10,10,8,10"
                                   TextAlignment="Right"
                                   FontSize="12"
                                   FontFamily="Cascadia Mono,Consolas,Menlo,Monospace"
                                   Foreground="{DynamicResource Capsa.TextMuted}"
                                   Opacity="0.75" />
                    </ScrollViewer>
                </Border>

                <TextBox Grid.Column="1"
                         x:Name="TextHost"
                         Classes="code"
                         Padding="8,10,12,10"
                         Text="{Binding Text, Mode=TwoWay}"
                         IsReadOnly="{Binding IsReadOnly}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!-- 状态栏：总大小 / 字数 / 长度 + 编码下拉框 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Capsa.SurfaceAlt}"
                BorderBrush="{DynamicResource Capsa.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding TextStatsText}"
                           VerticalAlignment="Center"
                           Classes="caption"
                           FontFamily="Cascadia Mono,Consolas,Menlo,Monospace" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Encoding" Classes="caption" VerticalAlignment="Center" />
                    <ComboBox Classes="borderless"
                              Width="152"
                              ItemsSource="{Binding EncodingOptions}"
                              SelectedItem="{Binding SelectedEncoding}"
                              ToolTip.Tip="Text encoding — in read mode it only affects how bytes are decoded">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:EncodingOption">
                                <TextBlock Text="{Binding DisplayName}" FontSize="10.5" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
