<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Capsa.ViewModels.Dialogs"
        xmlns:dialogs="using:Capsa.Views.Dialogs"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="560"
        x:Class="Capsa.Views.Dialogs.ChipHealthWindow"
        x:DataType="vm:ChipHealthViewModel"
        Title="Chip Health Check"
        Icon="/Assets/avalonia-logo.ico"
        Width="1120" Height="474"
        MinWidth="1000" MinHeight="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Capsa.Bg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22,18,22,18">

        <!-- ================= 顶部：当前串口 ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,16">

            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Capsa.Accent}">
                <TextBlock Text="C"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Capsa.OnAccent}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Chip Health Check" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="CAPSA · CHIP HEALTH &amp; MEMORY VERIFY" Classes="caption" />
            </StackPanel>

            <Border Grid.Column="2" Classes="pill" Padding="11,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Ok}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PortBadge}"
                               FontSize="11"
                               FontFamily="Cascadia Mono,Consolas,Menlo,Monospace"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 破坏性提示 ================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource Capsa.Warn.Soft}"
                BorderBrush="{DynamicResource Capsa.Warn}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Text="!"
                           FontSize="12"
                           FontWeight="Bold"
                           Width="16"
                           Height="16"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Capsa.OnAccent}"
                           Background="{DynamicResource Capsa.Warn}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Destructive test: every populated chip is fully overwritten with 0x00 / 0xFF before it is read back. Existing data on all 8 chips will be erased — back it up first."
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Capsa.Text}" />
            </StackPanel>
        </Border>

        <!-- ================= 测试阵列（卡片直接贴在页面底色上，与主界面一致） ================= -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Test Array" Classes="title" />
                        <TextBlock Text="0x50 – 0x57 · I2C slave addresses"
                                   Classes="caption"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 图例：写入 / 读取 / 三种结果 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Write}" VerticalAlignment="Center" />
                            <TextBlock Text="WRITE" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Read}" VerticalAlignment="Center" />
                            <TextBlock Text="READ" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Width="1" Height="10" Background="{DynamicResource Capsa.Border}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Ok}" VerticalAlignment="Center" />
                            <TextBlock Text="HEALTHY" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Warn}" VerticalAlignment="Center" />
                            <TextBlock Text="WARN" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Medium}" VerticalAlignment="Center" />
                            <TextBlock Text="MEDIUM" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Err}" VerticalAlignment="Center" />
                            <TextBlock Text="ERR" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Slots}"
                          Margin="0,0,-10,-10"
                          VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotTestViewModel">
                        <dialogs:SlotTestCardView Margin="0,0,10,10" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ================= 底部：当前动作 / 取消 / 选项 / 开始 ================= -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="2,16,2,0">

            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="6" Height="6"
                             Fill="{DynamicResource Capsa.Accent}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActionText}"
                               FontSize="11"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />

                    <!-- 传输速率：测试中显示实时值，结束后显示平均速率 -->
                    <TextBlock Text="{Binding SpeedText}"
                               Margin="4,0,0,0"
                               FontSize="10.5"
                               FontFamily="Cascadia Mono,Consolas,Menlo,Monospace"
                               Foreground="{DynamicResource Capsa.TextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}"
                           Classes="caption"
                           Margin="14,0,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="ghost"
                    MinWidth="96"
                    Margin="16,0,0,0"
                    Content="{Binding SecondaryButtonText}"
                    Command="{Binding CancelCommand}" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="14"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <CheckBox Content="Test 0x00 read/write"
                          FontSize="11"
                          IsChecked="{Binding TestPattern00}"
                          IsEnabled="{Binding !IsRunning}" />
                <Button Classes="ghost"
                        MinWidth="118"
                        MinHeight="36"
                        Content="Quick check"
                        ToolTip.Tip="Write pattern to the first 256 bytes of each chip and read back to verify — finishes in seconds"
                        IsEnabled="{Binding CanStart}"
                        Command="{Binding QuickCheckCommand}" />
                <Button Classes="primary"
                        MinWidth="132"
                        MinHeight="36"
                        Content="{Binding PrimaryButtonText}"
                        IsDefault="True"
                        IsEnabled="{Binding CanStart}"
                        Command="{Binding StartTestCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
