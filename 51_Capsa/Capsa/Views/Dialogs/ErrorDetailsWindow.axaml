<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="460"
        x:Class="Capsa.Views.Dialogs.ErrorDetailsWindow"
        Title="Error details"
        Icon="/Assets/avalonia-logo.ico"
        Width="640" Height="480"
        MinWidth="480" MinHeight="320"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Capsa.Bg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22,20,22,18">

        <!-- 标题 + 摘要 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Capsa.Err.Soft}">
                <TextBlock Text="!"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Capsa.Err}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,2,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Capsa.TextMuted}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="HintText"
                   Margin="0,0,0,6"
                   Text="Full detail below — select any part (Ctrl+A selects all), then Copy."
                   Classes="caption"
                   Foreground="{DynamicResource Capsa.TextMuted}" />

        <!-- 详情：只读但完全可选、可复制 -->
        <Border Grid.Row="2" Classes="card" Padding="10,8">
            <TextBox x:Name="DetailBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,Menlo,Monospace"
                     FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- 操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button x:Name="CopyButton"
                    Classes="ghost"
                    MinWidth="110" Height="34"
                    Content="Copy"
                    Click="OnCopyClick" />
            <Button x:Name="CopyAllButton"
                    Classes="ghost"
                    MinWidth="150" Height="34"
                    Content="Copy full log"
                    Click="OnCopyAllClick" />
            <Button Classes="primary"
                    MinWidth="96" Height="34"
                    Content="Close"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
