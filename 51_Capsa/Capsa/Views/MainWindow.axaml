<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Capsa.ViewModels"
        xmlns:shell="using:Capsa.Views.Shell"
        xmlns:panels="using:Capsa.Views.Panels"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="860"
        x:Class="Capsa.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Capsa · I2C EEPROM Workbench"
        Icon="/Assets/avalonia-logo.ico"
        Width="1320" Height="830"
        MinWidth="1160" MinHeight="680"
        Background="{DynamicResource Capsa.Bg}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ 顶部：品牌 + 串口选择 ============ -->
        <shell:TopBarView Grid.Row="0"
                          Margin="18,16,18,0"
                          DataContext="{Binding TopBar}" />

        <!-- ============ 主体：左信息面板 / 右操作面板 ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="338,*" Margin="18,14,18,8">

            <!-- 左：属性及信息面板 -->
            <panels:DeviceInfoPanelView Grid.Column="0" DataContext="{Binding DeviceInfo}" />

            <!-- 右：用户操作面板 -->
            <Grid Grid.Column="1" Margin="14,0,0,0" RowDefinitions="Auto,Auto,*">

                <!-- 存储卡阵列标题 + 图例 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Storage Array" Classes="title" />
                        <TextBlock Text="0x50 – 0x57 · I2C slave addresses"
                                   Classes="caption"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Ok}" VerticalAlignment="Center" />
                            <TextBlock Text="HEALTH" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Warn}" VerticalAlignment="Center" />
                            <TextBlock Text="WARN" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Capsa.Err}" VerticalAlignment="Center" />
                            <TextBlock Text="ERR" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 8 个单元卡片 -->
                <panels:ChipSlotBoardView Grid.Row="1" DataContext="{Binding Board}" />

                <!-- 写入 / 读取 标签页 -->
                <Border Grid.Row="2" Classes="card" Padding="0" Margin="0,12,0,0">
                    <TabControl x:Name="MainTabs"
                                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                        <TabItem Header="Write mode">
                            <panels:WritePanelView Margin="16,10,16,16" DataContext="{Binding Write}" />
                        </TabItem>
                        <TabItem Header="Read mode">
                            <panels:ReadPanelView Margin="16,10,16,16" DataContext="{Binding Read}" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 底部：项目地址 + 版本 ============ -->
        <shell:FooterBarView Grid.Row="2" DataContext="{Binding}" />
    </Grid>
</Window>
