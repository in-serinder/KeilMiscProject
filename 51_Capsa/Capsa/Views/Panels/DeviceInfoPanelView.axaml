<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Capsa.ViewModels.Panels"
             xmlns:illus="using:Capsa.Views.Illustrations"
             mc:Ignorable="d" d:DesignWidth="338" d:DesignHeight="700"
             x:Class="Capsa.Views.Panels.DeviceInfoPanelView"
             x:DataType="vm:DeviceInfoViewModel">

    <Border Classes="card">
        <Grid RowDefinitions="Auto,*">

            <!-- 面板标题 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="Properties / Chip info" Classes="title" />
                    <TextBlock Text="PROPERTIES · DEVICE INFO" Classes="caption" />
                </StackPanel>

                <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource Capsa.Err}"
                                 IsVisible="{Binding !IsInitialized}" />
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource Capsa.Ok}"
                                 IsVisible="{Binding IsInitialized}" />
                        <TextBlock Text="{Binding StateText}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 未初始化：插画 + 提示 ===== -->
            <StackPanel Grid.Row="1"
                        IsVisible="{Binding !IsInitialized}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="14"
                        Margin="28,0,28,40">

                <illus:EmptyCardIllustration Width="236" Height="164" Opacity="0.95" />

                <StackPanel Spacing="6">
                    <TextBlock Text="No storage chip detected"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Capsa.Text}" />
                    <TextBlock Text="Select a serial port and connect the device. Chip properties and health appear here after initialization."
                               FontSize="10.5"
                               LineHeight="17"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Capsa.TextMuted}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== 已初始化：垂直信息列表 ===== -->
            <ScrollViewer Grid.Row="1"
                          IsVisible="{Binding IsInitialized}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,4,16,16" Spacing="0">

                    <!-- 设备名 -->
                    <Grid ColumnDefinitions="84,*" Height="30">
                        <TextBlock Grid.Column="0" Text="Device name" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" Classes="value" />
                    </Grid>

                    <!-- UID -->
                    <Grid ColumnDefinitions="84,*" Height="30">
                        <TextBlock Grid.Column="0" Text="Unique UID" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding Uid}" Classes="value mono" FontSize="11" />
                    </Grid>

                    <!-- 型号 -->
                    <Grid ColumnDefinitions="84,*" Height="30">
                        <TextBlock Grid.Column="0" Text="Chip model" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding ChipModel}" Classes="value" />
                    </Grid>

                    <!-- 类型 -->
                    <Grid ColumnDefinitions="84,*" Height="30">
                        <TextBlock Grid.Column="0" Text="Chip type" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding ChipType}" Classes="value" />
                    </Grid>

                    <!-- 容量 -->
                    <Grid ColumnDefinitions="84,*" Height="30">
                        <TextBlock Grid.Column="0" Text="Chip capacity" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding CapacityText}" Classes="value" />
                    </Grid>

                    <!-- 阵列总容量：随写保护变化（保护片被剔出有效空间）-->
                    <Grid ColumnDefinitions="84,*" Height="30">
                        <TextBlock Grid.Column="0" Text="Card capacity" Classes="label" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ArrayCapacityText}"
                                   Classes="value"
                                   ToolTip.Tip="Total array capacity; chips set to WP are excluded" />
                    </Grid>

                    <Border Classes="separator" Margin="0,8,0,10" />

                    <!-- 容量使用情况 -->
                    <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Capacity usage" Classes="label" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding UsagePercent, StringFormat='{}{0:0.#}%'}"
                                       Classes="value"
                                       FontSize="11" />
                        </Grid>

                        <!-- 容量进度条（自定义三层）：
                             底轨灰 → 黄色段 = 写保护片容量（从右向左，不可用区）
                             → 蓝色段 = 已用容量（从左向右）。两段同以满容量为基准。-->
                        <Grid Height="10" ClipToBounds="True">
                            <Border Background="{DynamicResource Capsa.Border}"
                                    CornerRadius="3" Opacity="0.45" />
                            <Border Background="{Binding ProtectedBrush}"
                                    CornerRadius="3,0,0,3">
                                <Border.RenderTransformOrigin>100%,50%</Border.RenderTransformOrigin>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding ProtectedRatio}" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Border Background="{DynamicResource Capsa.Accent}"
                                    CornerRadius="3,0,0,3"
                                    ClipToBounds="True">
                                <Border.RenderTransformOrigin>0%,50%</Border.RenderTransformOrigin>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding UsageRatio}" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding UsageText}" Classes="hint" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Classes="separator" Margin="0,12,0,10" />

                    <!-- 时间 -->
                    <Grid ColumnDefinitions="84,*" Height="28">
                        <TextBlock Grid.Column="0" Text="Last modified" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding LastWriteText}" Classes="value mono" FontSize="10.5" />
                    </Grid>

                    <Grid ColumnDefinitions="84,*" Height="28">
                        <TextBlock Grid.Column="0" Text="Last accessed" Classes="label" />
                        <TextBlock Grid.Column="1" Text="{Binding LastAccessText}" Classes="value mono" FontSize="10.5" />
                    </Grid>

                    <!-- 数据哈希 + 累计写入次数（DI / DIG） -->
                    <Grid ColumnDefinitions="84,*" Height="28" ToolTip.Tip="{Binding IntegrityTooltip}">
                        <TextBlock Grid.Column="0" Text="Data hash" Classes="label" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding IntegrityText}"
                                   Classes="value mono"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Border Classes="separator" Margin="0,10,0,12" />

                    <!-- 健康分 -->
                    <Border Background="{Binding HealthSoftBrush}"
                            CornerRadius="10"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Health score" Classes="label" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding HealthScoreText}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{Binding HealthBrush}" />
                                    <TextBlock Text="/ 100"
                                               FontSize="10"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,5"
                                               Foreground="{DynamicResource Capsa.TextMuted}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Width="86">
                                <Border Background="{Binding HealthBrush}"
                                        CornerRadius="3"
                                        Padding="7,2"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding HealthLevelText}"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </Border>
                                <ProgressBar Classes="hairline"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding HealthScoreValue}"
                                             Foreground="{Binding HealthBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding HealthHint}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
