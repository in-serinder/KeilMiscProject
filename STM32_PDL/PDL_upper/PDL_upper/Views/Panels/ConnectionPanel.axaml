<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDL_upper.ViewModels"
             x:Class="PDL_upper.Views.Panels.ConnectionPanel"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <StackPanel Orientation="Vertical">
            <TextBox Text="{Binding Host}" Width="110" Watermark="主机"
                     Background="#23272F" BorderBrush="#2E333D"
                     IsEnabled="{Binding !IsAcquiring}"/>
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <TextBox Text="{Binding Port}" Width="62" Watermark="端口"
                     Background="#23272F" BorderBrush="#2E333D"
                     IsEnabled="{Binding !IsAcquiring}"/>
        </StackPanel>
        <Button Content="{Binding ConnectText}" Command="{Binding ConnectCommand}"
                Background="#1D5C3A" Padding="12,8" FontWeight="SemiBold"
                VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#8B93A1"/>
    </StackPanel>
</UserControl>
