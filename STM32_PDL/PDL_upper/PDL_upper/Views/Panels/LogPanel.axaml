<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDL_upper.ViewModels"
             x:Class="PDL_upper.Views.Panels.LogPanel"
             x:DataType="vm:LogViewModel">
    <ListBox ItemsSource="{Binding Entries}" Background="#16181D" BorderThickness="0"
             x:Name="List">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogEntry">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Time}" Foreground="#5F6672" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="{Binding Level}" Foreground="#8B93A1" FontFamily="Consolas" FontSize="11" Width="42"/>
                    <TextBlock Text="{Binding Msg}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
