<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：颜色表与 docs/04 第 8 章一致 -->
    <Style Selector="Button">
        <Setter Property="Foreground" Value="#E6E8EC"/>
        <Setter Property="Background" Value="#23272F"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E333D"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#1E2127"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="#E6E8EC"/>
        <Setter Property="Background" Value="#23272F"/>
        <Setter Property="BorderBrush" Value="#2E333D"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#4A9EFF"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Foreground" Value="#E6E8EC"/>
        <Setter Property="Background" Value="#23272F"/>
        <Setter Property="BorderBrush" Value="#2E333D"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#C9CDD4"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="#16181D"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,1"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Track">
        <Setter Property="Background" Value="#2E333D"/>
    </Style>
</Styles>
