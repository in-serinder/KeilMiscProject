  35   1          /* ---- 硬件定时器驱动系统滴答 ----
  36   1           * 晶振：11.0592MHz  
  37   1           * 模式：12T（默认，AUXR保持默认，不要开1T）
  38   1           *       ÷12后 = 11059200/12 = 921600 Hz
  39   1           * 10ms 需要 tick = 921600 × 0.01 = 9216
  40   1           * 重装值 = 65536 - 9216 = 56320 = 0xDC00  
  41   1           *   【为什么不开1T？】
  42   1           *   1T模式下10ms需要 110592 tick，超过16位最大值65536！装不下。
  43   1           *   12T模式0xDC00刚好10ms/次 → sys_tick_10ms 名实相符，
  44   1           *   上层所有参数(REFRESH_INTERVAL_TICK=50=0.5s、
  45   1           *   KEY_LONGPRESS_CYCLES=300=3s、OBO_DEBOUNCE=2=20ms) 全部不用改。
  46   1           */
  47   1          AUXR &= 0x7F;         // ★ 关闭1T模式！使用传统12T（与99%8051代码兼容）
  48   1          TMOD &= 0xF0;         // Timer0 模式1（16位手动重装）
  49   1          TMOD |= 0x01;
  50   1          TH0 = 0xDC;           // 高8位
  51   1          TL0 = 0x00;           // 低8位  → 0xDC00 = 10ms@11.0592MHz 12T
  52   1          TF0 = 0;              // 清溢出标志
  53   1          ET0 = 1;              // 使能Timer0中断（之前漏了！定时器中断没开）
  54   1          TR0 = 1;              // 启动Timer0
