 156          void Max7219_DisplayFloat(float value, uint8_t format)
 157          {
 158   1          uint32_t scaled;
 159   1          bit neg = 0;
 160   1          uint8_t i;
 161   1          uint32_t mul = 1;
 162   1          if (format > 7) format = 7;
 163   1          if (value < 0) { neg = 1; value = -value; }
 164   1          for (i = 0; i < format; i++) mul *= 10;
 165   1          scaled = (uint32_t)(value * (float)mul + 0.5f);
 166   1          WriteRange(1, 8, scaled, format, neg);
 167   1      }
