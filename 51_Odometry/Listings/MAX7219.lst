 186          /* 左右双值显示，左右可用不同小数位数 */
 187          void Max7219_DisplayDualFmt(float left_val, uint8_t left_fmt,
 188                                     float right_val, uint8_t right_fmt)
 189          {
 190   1          uint32_t sl, sr;
 191   1          bit nl = 0, nr = 0;
 192   1          uint8_t i;
 193   1          uint32_t mul;
 194   1      
 195   1          if (left_fmt > 3)  left_fmt = 3;
 196   1          if (right_fmt > 3) right_fmt = 3;
 197   1      
 198   1          if (left_val < 0)  { nl = 1; left_val = -left_val; }
 199   1          if (right_val < 0) { nr = 1; right_val = -right_val; }
 200   1      
 201   1          mul = 1;
 202   1          for (i = 0; i < left_fmt; i++) mul *= 10;
 203   1          sl = (uint32_t)(left_val * (float)mul + 0.5f);
 204   1      
 205   1          mul = 1;
 206   1          for (i = 0; i < right_fmt; i++) mul *= 10;
 207   1          sr = (uint32_t)(right_val * (float)mul + 0.5f);
 208   1      
 209   1          WriteRange(1, 4, sl, left_fmt, nl);
 210   1          WriteRange(5, 8, sr, right_fmt, nr);
 211   1      }
