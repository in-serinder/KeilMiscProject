  99          static void WriteRange(uint8_t left_pos, uint8_t right_pos,
 100                                 uint32_t scaled, uint8_t format, bit neg)
 101          {
 102   1          uint8_t total = right_pos - left_pos + 1;
 103   1          uint8_t xdata dig[8];
 104   1          uint8_t xdata dot[8];
 105   1              uint8_t i, fill;
 106   1          uint8_t phys;
 107   1          for (i = 0; i < 8; i++) { dig[i] = 0; dot[i] = 0; }
 108   1      
 109   1          fill = total - 1;
 110   1          do {
 111   2              dig[fill] = (uint8_t)(scaled % 10);
 112   2              if (format != 0 && fill == total - 1 - format) dot[fill] = 1;
 113   2              scaled /= 10;
 114   2              if (fill == 0) break;
 115   2              fill--;
 116   2          } while (scaled > 0);
C51 COMPILER V9.59.0.0   MAX7219                                                           07/28/2026 22:17:55 PAGE 3   

 117   1      
 118   1          /* 剩余左边位置熄灭（消隐），实现右对齐 */
 119   1          for (i = 0; i < fill; i++)
 120   1              dig[i] = MAX7219_BLANK;
 121   1      
 122   1              if (neg && fill > 0) {
 123   2              fill--;
 124   2              dig[fill] = 0x0A;
 125   2          }
 126   1      
 127   1          /* ====== 消隐前导零：把整数部分左边多余的0熄灭 ====== */
 128   1          {
 129   2              uint8_t first_nonzero = total;
 130   2              for (i = 0; i < total; i++) {
 131   3                  if (dig[i] != MAX7219_BLANK && dig[i] != 0 && dig[i] != 0x0A) {
 132   4                      first_nonzero = i;
 133   4                      break;
 134   4                  }
 135   3              }
 136   2              /* 全是0 → 保留最后一个位置显示0 */
 137   2              if (first_nonzero == total) first_nonzero = total - 1;
 138   2              /* 把第一个有效数字左边的0也熄灭 */
 139   2              for (i = 0; i < first_nonzero; i++) {
 140   3                  if (dig[i] == 0) {
 141   4                      dig[i] = MAX7219_BLANK;
 142   4                      dot[i] = 0;
 143   4                  }
 144   3              }
 145   2          }
 146   1      
 147   1          for (i = 0; i < total; i++) {
 148   2              phys = PosMap(left_pos + i);
 149   2              if (dig[i] == MAX7219_BLANK)
 150   2                  Max7219_DisplayBlank(phys, dot[i]);
 151   2              else
 152   2                  Max7219_Display(phys, dig[i], dot[i]);
 153   2          }
 154   1      }
