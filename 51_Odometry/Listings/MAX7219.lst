 270          /* 自定义段码显示（非译码模式显示字母）
 271           * segs[] 前 len 个元素为段码字节（SEG_S / SEG_U ...），
 272           * 左对齐显示在8位数码管上，空白位熄灭。
 273           * 完成后恢复BCD译码模式。
 274           */
 275          void Max7219_DisplayCustomSegments(const uint8_t *segs, uint8_t len)
 276          {
 277   1          uint8_t i;
 278   1          Max7219_Clear();
 279   1          /* 切换到非译码模式 */
 280   1          Max7219_Write(0x09, 0x00);
 281   1          for (i = 0; i < 8; i++) {
 282   2              if (i < len)
 283   2                  Max7219_Write(i + 1, segs[i]);
 284   2              else
 285   2                  Max7219_Write(i + 1, SEG_BLANK);
 286   2          }
 287   1              /* 恢复BCD译码模式 */
 288   1          Max7219_Write(0x09, 0xFF);
 289   1      }
