 186   2               */
 187   2              cyc_sum -= cyc_buf[cyc_idx];   // 挤出最旧的值
 188   2              cyc_buf[cyc_idx] = spd;         // 填入最新的值
 189   2              cyc_sum += spd;                 // 累加新值
 190   2              cyc_idx++;
