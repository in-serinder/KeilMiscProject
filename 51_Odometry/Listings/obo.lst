 199   2              UART_SendString(" out="); UART_SendFloat2(speed_kmh);
 200   2              UART_SendString("\r\n");
 201   2          }
 202   1      
 203   1          /*  零速限幅 */
 204   1          if (speed_kmh < SPEED_ZERO_KMH) speed_kmh = 0.0f;
 205   1      
 206   1          /*  推行/静止滤波 & 有效里程 */
 207   1          if (speed_kmh >= WALKING_SPEED_KMH) {
 208   2              riding = 1; slow_count = 0;
 209   2          } else {
 210   2              riding = 0; slow_count++;
 211   2          }
 212   1          if (riding)
 213   1              valid_mm += (uint32_t)(raw_mm - last_raw_mm);
 214   1      
 215   1          last_raw_mm = raw_mm;
 216   1      
 217   1          /* EEPROM 周期性保存 */
