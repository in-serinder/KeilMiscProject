 145          float OBO_GET_SPEED(void)
 146          {
 147   1          float spd;
 148   1          uint16_t now, elp;
 149   1          uint8_t riding;
 150   1      
 151   1          now = sys_tick_10ms;
 152   1      
 153   1          /*  1s窗口到期：算一次原始速度 */
 154   1          elp = (uint16_t)(now - wnd_tick);
 155   1          if (elp >= WIN_TICK) {
 156   2              uint32_t delta_mm;
 157   2              if (raw_mm >= wnd_raw)
 158   2                  delta_mm = raw_mm - wnd_raw;
 159   2              else
 160   2                  delta_mm = 0;
 161   2              spd = (float)delta_mm * 3.6f / (float)elp;
 162   2              wnd_raw  = raw_mm;
 163   2              wnd_tick = now;
 164   2      
 165   2              /* 调试：窗口结果（主循环调用，可安全用UART） */
 166   2              UART_SendString("[W] elp="); UART_SendU16(elp);
 167   2              UART_SendString(" pls="); UART_SendU16(wnd_pulse);
 168   2              UART_SendString(" dlt="); UART_SendU32(delta_mm);
 169   2              UART_SendString(" spd="); UART_SendFloat2(spd);
 170   2      
 171   2              /*  尖峰剔除：1秒内脉冲数超过上限 → 整帧强制归零 */
 172   2              if (wnd_pulse > MAX_PULSES_PER_WINDOW) {
 173   3                  spd = 0.0f;
 174   3                  UART_SendString(" SPIKE!");
 175   3              }
 176   2              wnd_pulse = 0;
 177   2      
 178   2              /* ---- 10秒环形缓冲（真正的滑动平均）----
C51 COMPILER V9.59.0.0   OBO                                                               07/29/2026 09:19:00 PAGE 4   

 179   2               *   cyc_buf[0~9]：最近10个1s窗口的速度
