  82          /* 打印 float (保留2位小数) */
  83          void UART_SendFloat2(float val)
  84          {
  85   1          uint16_t int_part;
  86   1          uint8_t frac;
  87   1          if (val < 0) { UART_SendByte('-'); val = -val; }
