  47          void UART_SendHex(uint8_t byte)
  48          {
  49   1        uint8_t high, low;
  50   1        high = byte >> 4;
  51   1        low = byte & 0x0F;
  52   1        if(high < 10) UART_SendByte('0' + high);
  53   1        else UART_SendByte('A' + (high - 10));
  54   1        if(low < 10) UART_SendByte('0' + low);
