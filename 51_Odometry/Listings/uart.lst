  58          /* 打印 uint16 十进制 */
  59          void UART_SendU16(uint16_t val)
  60          {
  61   1          uint8_t buf[5], i = 0;
  62   1          if (val == 0) { UART_SendByte('0'); return; }
  63   1          while (val > 0 && i < 5) {
  64   2              buf[i++] = '0' + (val % 10);
