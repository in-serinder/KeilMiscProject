   3          // ============================================================
   4          // 11.0592MHz  9600bps  最经典零误差配置！
   5          // 定时器1  12T模式(AUXR.6=0)  模式2(8位自动重装)
   6          // SMOD=0 : TH1 = 256 - 11059200/(12*32*9600) = 256 - 3 = 0xFD
   7          // 误差 = 0% ，必通！
   8          // ============================================================
   9          void UART_Init(void)
  10          {
  11   1          SCON  = 0x50;    // 8位UART，模式1，REN=1允许接收
  12   1          PCON &= 0x7F;    // SMOD=0（不倍频，配合0xFD正好9600bps 0%误差）
  13   1          AUXR &= 0xBF;    // AUXR.6 = T1x12 = 0  → 定时器1走12T（传统模式，最稳）
  14   1          AUXR &= 0xFE;    // AUXR.0 = 0        → 串口用T1做波特率发生器
  15   1          TMOD &= 0x0F;    // 清掉T1的模式位
  16   1          TMOD |= 0x20;    // T1 = 模式2（8位自动重装）
  17   1          TL1 = 0xFD;      // 初值
  18   1          TH1 = 0xFD;      // 重装值  ← 就是这个0xFD，11.0592配9600绝对零误差
  19   1          ET1 = 0;         // 禁止T1中断
  20   1          ES  = 0;         // 禁止串口中断（查询发送）
  21   1          TR1 = 1;         // 启动T1
  22   1          TI  = 1;         // 预设TI=1，避免首次SendByte的while逻辑不清晰
  23   1      
  24   1          // ===== 最简自检：先发 0x55 0x55 0x55，再 U 回车 =====
  25   1          // 0x55 = 01010101，最容易验证波特率对不对
  26   1          // 串口助手收到的应该是三个大写字母 "U" 开头
  27   1          UART_SendByte(0x55);
  28   1          UART_SendByte(0x55);
  29   1          UART_SendByte(0x55);
  30   1          UART_SendByte('\r');
  31   1          UART_SendByte('\n');
  32   1      }
  33          
  34          void UART_SendByte(uint8_t byte)
  35          {
  36   1          TI = 0;         // 先清零TI
  37   1          SBUF = byte;    // 写缓冲启动发送
  38   1          while (!TI);    // 等待发送结束（硬件置TI=1）
  39   1      }
  40          
  41          void UART_SendString(uint8_t *str)
  42          {
  43   1        while(*str)
  44   1          UART_SendByte(*str++);
  45   1      }
