   1          /* delay.c — 软件延时 @ STC8G1K08A 22.1184MHz 1T
   2           *
   3           * 说明：
   4           *   Delay1us 只给 TM1637 这类位操作当"延时单元"用。
   5           *   按 C51 生成的汇编算：MOV(1) + DJNZ(2) + DJNZ(2) + RET(2) = 7 个时钟，
   6           *   加上 LCALL/RET 与循环开销，delay_us(1) 约 0.65us（不是 1us，别拿它当精确定时）�
             -��
   7           *   Delay1ms 由 22*128 次空循环构成，22.1184MHz/1T 下接近 1ms；
   8           *   它只用于 24Cxx 写周期与 2s 协议超时，误差几 % 无影响。
   9           */
  10          #include "delay.h"
  11          
  12          void Delay1us(void)
  13          {
  14   1          uint8_t i;
  15   1      
  16   1          i = 3;
  17   1          while (--i);
  18   1      }
  19          
  20          void Delay1ms(void)
  21          {
  22   1          uint8_t i, j;
  23   1      
  24   1          _nop_();
  25   1          _nop_();
  26   1          i = 22;
  27   1          j = 128;
  28   1          do
  29   1          {
  30   2              while (--j);
  31   2          } while (--i);
  32   1      }
  33          
  34          void delay_us(uint16_t us)
  35          {
  36   1          while (us--)
  37   1          {
  38   2              Delay1us();
  39   2          }
  40   1      }
  41          
  42          void delay_ms(uint16_t ms)
  43          {
  44   1          while (ms--)
  45   1          {
  46   2              Delay1ms();
  47   2          }
  48   1      }


