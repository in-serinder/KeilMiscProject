   1          /* uart.c — 串口1 调试输出（9600 8N1 @22.1184MHz）
   2           *
   3           * 定时器1 作波特率发生器，12T + 16 位自动重装，重装值 0xFFD0：
   4           *   baud = 22118400 / 12 / 4 / (65536 - 0xFFD0) = 9600，误差 0%。
   5           *
   6           * 只发不收：本工程不需要接收，不开 ES，避免和 main 抢中断。
   7           */
   8          #include "uart.h"
   9          
  10          #if CFG_DEBUG_UART
  11          
  12          void Uart1_Init(void)
  13          {
  14   1          SCON = 0x50;        /* 8 位数据，可变波特率，REN=1（不收也无妨） */
  15   1          AUXR &= 0xBF;       /* 定时器1 时钟 12T 模式（bit7 = T0x12 必须保留） */
  16   1          AUXR &= 0xFE;       /* 串口1 选择定时器1 为波特率发生器 */
  17   1          TMOD &= 0x0F;       /* 定时器1 -> 模式0（STC8：16 位自动重装载） */
  18   1          TL1 = 0xD0;
  19   1          TH1 = 0xFF;
  20   1          ET1 = 0;            /* 禁止定时器1中断 */
  21   1          TR1 = 1;            /* 启动定时器1 */
  22   1          TI = 0;
  23   1          RI = 0;
  24   1      }
  25          
  26          void Uart1_SendByte(uint8_t dat)
  27          {
  28   1          TI = 0;
  29   1          SBUF = dat;
  30   1          while (!TI);
  31   1          TI = 0;
  32   1      }
