 241          /* 按一次触发一次；按住 500ms 后每 100ms 再触发一次。
 242           * 返回 1 表示"这一拍该执行一次" */
 243          static uint8_t Key_Repeat(uint8_t down, uint16_t *hold, uint8_t *fired)
 244          {
 245   1          if (down == 0)
 246   1          {
 247   2              *hold = 0;
 248   2              *fired = 0;
 249   2              return 0;
 250   2          }
 251   1      
 252   1          if (*hold < 60000)
 253   1          {
 254   2              *hold = (uint16_t)(*hold + 10);
 255   2          }
 256   1      
 257   1          if (*fired == 0)
 258   1          {
 259   2              *fired = 1;                 /* 首次按下立刻响应 */
 260   2              return 1;
 261   2          }
 262   1      
 263   1          if ((*hold >= 500) && (((*hold - 500) % 100) == 0))
 264   1          {
 265   2              return 1;
 266   2          }
 267   1      
 268   1          return 0;
 269   1      }
