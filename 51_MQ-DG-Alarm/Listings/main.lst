  58          static void Timer0_Init(void)
  59          {
  60   1          AUXR |= 0x80;               /* T0 用 1T 模式 */
  61   1          TMOD &= 0xF0;               /* T0 -> 模式 0（STC8 里是 16 位自动重装） */
  62   1          TL0 = T0_RELOAD_L;
  63   1          TH0 = T0_RELOAD_H;
  64   1          ET0 = 1;
  65   1          TR0 = 1;
  66   1      }
  67          
  68          void Timer0_Isr(void) interrupt 1
  69          {
  70   1          s_ms++;
  71   1      }
  72          
  73          /* 16 位计数器跨中断读取会撕裂，读的时候短暂关掉 T0 中断 */
  74          static uint16_t Now_ms(void)
  75          {
  76   1          uint16_t t;
  77   1      
  78   1          ET0 = 0;
  79   1          t = s_ms;
  80   1          ET0 = 1;
  81   1          return t;
  82   1      }
