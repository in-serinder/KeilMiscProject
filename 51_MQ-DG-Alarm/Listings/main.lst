   1          /* =====================================================================
   2           * main.c  —  MQ 传感器阈值报警器
   3           *
   4           * 功能：
   5           *   采集模式：四位数码管持续显示 MQ 的 ADC 采样值（0~4095），
   6           *             采样值 >= 阈值时有源蜂鸣器（P3.3 高电平）长鸣，
   7           *             回落到 阈值-CFG_TH_HYST 以下才停，避免阈值附近抖。
   8           *   设置模式：按一次 add/sub 进入，数码管闪烁显示阈值（250ms 亮/灭），
   9           *             期间可继续用 add/sub 加减（按住 0.5s 后每 100ms 连发），
  10           *             3 秒无操作自动退回采集模式；阈值改过则在退出时写入 EEPROM。
  11           *
  12           * 定时基准：
  13           *   Timer0 工作在 1T + 16 位自动重装，1ms 中断一次，主循环用时间戳
  14           *   做"协作式调度"（按键 10ms / 采样 200ms / 刷新 50ms），不用阻塞延时。
  15           *
  16           * 显示刷新：
  17           *   段码先与缓存比对，内容没变就不发总线帧（TM1637 一帧约 80us，
  18           *   闪烁时每秒要改 4 次，做差分能明显减少总线占用和干扰）。
  19           * ===================================================================== */
  20          #include "board.h"
  21          #include "delay.h"
  22          #include "TM1637.h"
  23          #include "adc.h"
  24          #include "key.h"
