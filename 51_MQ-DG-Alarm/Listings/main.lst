  35          #define T0_RELOAD_L             0x9A
  36          
  37          static volatile uint16_t s_ms;              /* 上电以来的毫秒数 */
  38          
  39          static uint8_t  s_seg[4];                   /* 显示缓存（差分刷新用） */
  40          static uint8_t  s_seg_ok;
  41          
  42          static uint16_t s_th;                       /* 当前阈值 */
  43          static uint16_t s_th_bak;                   /* 进入设置模式时的阈值，用于判断"改过没有"
             - */
  44          static uint16_t s_meas;                     /* 采集值（一阶滤波后） */
  45          static uint8_t  s_mode;                     /* MODE_MEAS / MODE_SET */
  46          static uint16_t s_set_left;                 /* 设置模式剩余时间 ms */
  47          static uint8_t  s_buzz;                     /* 蜂鸣器当前状态 */
  48          static uint8_t  s_adc_err;                  /* 1 = ADC 转换超时（不是输入 0V） */
  49          static uint8_t  s_no_adc;                   /* 1 = 片上没有 ADC 模块 */
