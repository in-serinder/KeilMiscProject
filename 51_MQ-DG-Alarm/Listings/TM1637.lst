 185          void TM1637_Show4(const char *s, bit colon)
 186          {
 187   1          uint8_t seg[4];
 188   1          uint8_t i;
 189   1      
 190   1          for (i = 0; i < 4; i++)
 191   1          {
 192   2              seg[i] = TM1637_CharToSeg(s[i]);
 193   2          }
 194   1          if (colon)
 195   1          {
 196   2              seg[2] |= 0x80;         /* 模块第 2 位带小数点 */
 197   2          }
 198   1          TM1637_WriteSegs(seg, 4);
 199   1      }
