  98          /* ---------------- 对外 ---------------- */
  99          void TM1637_SetBright(uint8_t level)
 100          {
 101   1          if (level > 7)
 102   1          {
 103   2              level = 7;
 104   2          }
 105   1          tm_start();
 106   1          tm_write((uint8_t)(0x88 | level));      /* 开显示 + 亮度 */
 107   1          tm_stop();
 108   1      }
