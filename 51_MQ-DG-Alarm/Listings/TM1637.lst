 202          uint8_t TM1637_ReadKeys(uint8_t *buf, uint8_t n)
 203          {
 204   1          uint8_t i;
 205   1      
 206   1          if ((buf == 0) || (n == 0))
 207   1          {
 208   2              return 0;
