 144          uint8_t TM1637_CharToSeg(char c)
 145          {
 146   1          switch (c)
 147   1          {
 148   2          case '0': return 0x3F;
 149   2          case '1': return 0x06;
 150   2          case '2': return 0x5B;
 151   2          case '3': return 0x4F;
 152   2          case '4': return 0x66;
 153   2          case '5': return 0x6D;
 154   2          case '6': return 0x7D;
 155   2          case '7': return 0x07;
 156   2          case '8': return 0x7F;
 157   2          case '9': return 0x6F;
 158   2      
 159   2          case 'A': case 'a': return 0x77;
 160   2          case 'B': case 'b': return 0x7C;
 161   2          case 'C': case 'c': return 0x39;
 162   2          case 'D': case 'd': return 0x5E;
 163   2          case 'E': case 'e': return 0x79;
 164   2          case 'F': case 'f': return 0x71;
 165   2      
 166   2          case 'I': case 'i': return 0x06;    /* 一根竖线 */
 167   2          case 'L': case 'l': return 0x38;
 168   2          case 'O': case 'o': return 0x5C;
 169   2          case 'R': case 'r': return 0x50;    /* 只亮 e+g 两段，像杂点，状态码里已不再使用 */
 170   2          case 'W': case 'w': return 0x3E;    /* 七段画不出 W，只能用 U 形代替 */
 171   2          case 'U': case 'u': return 0x3E;    /* 0x3E = b,c,d,e,f，就是 "U" */
 172   2          case 'n':           return 0x54;
 173   2          case 'P': case 'p': return 0x73;
 174   2          case 'S': case 's': return 0x6D;    /* 与 '5' 同形 */
 175   2          case 't':           return 0x78;
 176   2          case 'H': case 'h': return 0x76;
 177   2          case 'y':           return 0x6E;
 178   2      
C51 COMPILER V9.59.0.0   TM1637                                                            11/24/2026 00:26:38 PAGE 4   

 179   2          case '-':           return 0x40;
 180   2          case ' ':           return 0x00;
 181   2          default:            return 0x00;
 182   2          }
 183   1      }
