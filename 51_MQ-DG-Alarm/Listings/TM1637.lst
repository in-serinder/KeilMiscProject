   1          /* =====================================================================
   2           * TM1637.c — 四位数码管驱动（起始/停止/写字节逻辑沿用原工程已验证版本）
   3           *
   4           * 命令字：
   5           *   0x40  数据命令：地址自动加一，写显存
   6           *   0xC0  地址命令：从第 1 位开始写
   7           *   0x88|亮度  显示控制：开显示 + 亮度(0~7)
   8           *
   9           * 说明：原来 TM1637_StringDisplay 里调用的 charToint() 从来没有定义过，
  10           *       这里改成 TM1637_CharToSeg() 统一做字符到段码的映射。
  11           * ===================================================================== */
  12          #include "TM1637.h"
  13          #include "delay.h"
  14          
  15          #define TM_DLY()    Delay_us(CFG_TM1637_DLY_US)
  16          
  17          /* ---------------- 底层时序 ---------------- */
  18          static void tm_start(void)
  19          {
  20   1          TM1637_CLK = 1;
  21   1          TM1637_DIO = 1;
  22   1          TM_DLY();
  23   1          TM1637_DIO = 0;         /* CLK 高时 DIO 下降沿 = 起始 */
  24   1          TM_DLY();
  25   1      }
  26          
  27          static void tm_stop(void)
  28          {
  29   1          TM1637_CLK = 0;
  30   1          TM_DLY();
  31   1          TM1637_DIO = 0;
  32   1          TM_DLY();
  33   1          TM1637_CLK = 1;
  34   1          TM_DLY();
  35   1          TM1637_DIO = 1;         /* CLK 高时 DIO 上升沿 = 停止 */
  36   1          TM_DLY();
  37   1      }
  38          
  39          /* 低位在前，第 9 个时钟只给脉冲，不读 ACK */
  40          static void tm_write(uint8_t byte)
  41          {
  42   1          uint8_t i;
  43   1      
  44   1          for (i = 0; i < 8; i++)
  45   1          {
  46   2              TM1637_CLK = 0;
  47   2              TM_DLY();
  48   2              TM1637_DIO = (byte & 0x01) ? 1 : 0;
  49   2              TM_DLY();
  50   2              byte >>= 1;
  51   2              TM1637_CLK = 1;
  52   2              TM_DLY();
  53   2          }
  54   1      
C51 COMPILER V9.59.0.0   TM1637                                                            11/24/2026 00:26:38 PAGE 2   

  55   1          TM1637_CLK = 0;
  56   1          TM1637_DIO = 1;
  57   1          TM_DLY();
  58   1          TM1637_CLK = 1;
  59   1          TM_DLY();
  60   1          TM1637_CLK = 0;
  61   1      }
  62          
  63          /* 低位在前读 1 字节。
  64           * 读之前必须把 DIO 写成 1（准双向口写 1 = 释放，引脚才变成输入）；
  65           * 漏了这一句，引脚被自己的下拉钉在 0，读回来永远是 0x00。
  66           * 之后第 9 个时钟是主机应答位，TM1637 不检查内容，给个脉冲即可。 */
  67          #if CFG_TM1637_KEYSCAN
  68          static uint8_t tm_read(uint8_t ack)
  69          {
  70   1          uint8_t i, dat = 0;
  71   1      
  72   1          TM1637_DIO = 1;
  73   1          for (i = 0; i < 8; i++)
  74   1          {
  75   2              TM1637_CLK = 0;
  76   2              TM_DLY();
  77   2              TM1637_CLK = 1;             /* 上升沿采样 */
  78   2              dat >>= 1;
  79   2              if (TM1637_DIO)
  80   2              {
  81   3                  dat |= 0x80;
  82   3              }
  83   2              TM_DLY();
  84   2          }
  85   1      
  86   1          TM1637_CLK = 0;
  87   1          TM1637_DIO = ack ? 0 : 1;       /* 应答：拉低表示"继续读" */
  88   1          TM_DLY();
  89   1          TM1637_CLK = 1;
  90   1          TM_DLY();
  91   1          TM1637_CLK = 0;
  92   1          TM1637_DIO = 1;
  93   1      
  94   1          return dat;
  95   1      }
  96          #endif /* CFG_TM1637_KEYSCAN */
