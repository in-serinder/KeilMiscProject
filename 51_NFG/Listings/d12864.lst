 202   1          send_command_to_ROM((fontaddr & 0xFF00) >> 8);
 203   1          send_command_to_ROM(fontaddr & 0xFF);
 204   1          for (j = 0; j < 2; j++)
 205   1          {
 206   2              lcd_address(page + j, column);
 207   2              for (i = 0; i < 16; i++)
 208   2              {
 209   3                  disp_data = get_data_from_ROM();
 210   3                  transfer_data_lcd(disp_data);
 211   3              }
 212   2          }
 213   1          ROM_CS = 1;
 214   1      }
