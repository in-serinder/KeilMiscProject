 444          /*
 445           * 函数: show_str_8x16
 446           * 输入: page - 起始页 (1~7, 字符高16像素占2页)
 447           *       col  - 起始列 (1~128)
 448           *       buf  - 字符串指针 (GB2312编码)
 449           * 输出: 无
 450           * 说明: 中号字符显示. 汉字16列宽(16x16), 英文8列宽(8x16).
 451           *       高度均为16像素(2个page).
 452           *       边界保护同 show_str_16x16.
 453           */
 454          void show_str_8x16(uchar page, uchar col, uchar *buf)
 455          {
 456   1          /* 8x16 中号与 16x16 大号使用相同的字库与尺寸,
 457   1             汉字16x16占16列, ASCII 8x16占8列, 高度均为2页 */
 458   1          show_str_16x16(page, col, buf);
 459   1      }
