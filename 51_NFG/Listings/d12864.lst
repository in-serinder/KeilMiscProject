 253          /* ================= 字符串显示 ================= */
 254          /* 显示GB2312字符串(16x16汉字 / 8x16 ASCII) */
 255          void display_GB2312_string(uchar page, uchar column, uchar *text)
 256          {
 257   1          uchar i = 0;
 258   1          ulong fontaddr;
 259   1          while (text[i] > 0x00)
 260   1          {
 261   2              if (((text[i] >= 0xB0) && (text[i] <= 0xF7)) && (text[i + 1] >= 0xA1))
 262   2              {
 263   3                  /* GB2312 简体汉字地址: ((MSB-0xB0)*94 + (LSB-0xA1) + 846) * 32 */
 264   3                  fontaddr  = (text[i] - 0xB0) * 94;
 265   3                  fontaddr += (text[i + 1] - 0xA1) + 846;
 266   3                  fontaddr  = (ulong)(fontaddr * 32);
 267   3                  get_and_write_16x16(fontaddr, page, column);
 268   3                  i += 2;
 269   3                  column += 16;
 270   3              }
 271   2              else if (((text[i] >= 0xA1) && (text[i] <= 0xA3)) && (text[i + 1] >= 0xA1))
 272   2              {
 273   3                  /* GB2312 15x16 字符地址: ((MSB-0xA1)*94 + (LSB-0xA1)) * 32 */
 274   3                  fontaddr  = (text[i] - 0xA1) * 94;
 275   3                  fontaddr += (text[i + 1] - 0xA1);
 276   3                  fontaddr  = (ulong)(fontaddr * 32);
 277   3                  get_and_write_16x16(fontaddr, page, column);
 278   3                  i += 2;
 279   3                  column += 16;
 280   3              }
 281   2              else if ((text[i] >= 0x20) && (text[i] <= 0x7E))
 282   2              {
 283   3                  /* 8x16 ASCII 基址 0x3CF80 */
 284   3                  fontaddr  = (text[i] - 0x20);
 285   3                  fontaddr  = (ulong)(fontaddr * 16);
 286   3                  fontaddr  = (ulong)(fontaddr + 0x3CF80);
 287   3                  get_and_write_8x16(fontaddr, page, column);
 288   3                  i += 1;
 289   3                  column += 8;
 290   3              }
 291   2              else
 292   2              {
 293   3                  i++;
 294   3              }
 295   2          }
 296   1      }
