 160          /* ================= 字库 IC 操作 ================= */
 161          /* 送指令到字库IC */
 162          void send_command_to_ROM(uchar datu)
 163          {
 164   1          uchar i;
 165   1          for (i = 0; i < 8; i++)
 166   1          {
 167   2              ROM_SCK = 0;
 168   2              delay_us(10);
 169   2              if (datu & 0x80) ROM_IN = 1;
 170   2              else             ROM_IN = 0;
 171   2              datu <<= 1;
 172   2              ROM_SCK = 1;
 173   2              delay_us(10);
 174   2          }
 175   1      }
 176          
 177          /* 从字库IC读取1字节 */
 178          uchar get_data_from_ROM(void)
C51 COMPILER V9.59.0.0   D12864                                                            10/12/2026 13:53:00 PAGE 4   

 179          {
 180   1          uchar i;
 181   1          uchar ret_data = 0;
 182   1          for (i = 0; i < 8; i++)
 183   1          {
 184   2              ROM_OUT = 1;            /* 准双向口: 写1置为输入态 */
 185   2              ROM_SCK = 0;            /* 下降沿后ROM输出下一位到SO */
 186   2              delay_us(5);            /* 等待SO数据稳定(STC8G主频高,必须延时) */
 187   2              ret_data <<= 1;
 188   2              if (ROM_OUT) ret_data |= 0x01;
 189   2              ROM_SCK = 1;
 190   2              delay_us(5);
 191   2          }
 192   1          return ret_data;
 193   1      }
