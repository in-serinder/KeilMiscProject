 461          /*
 462           * 函数: show_str_5x7
 463           * 输入: page - 页号 (1~8, 5x7字符高8像素占1页)
 464           *       col  - 起始列 (1~128)
 465           *       buf  - 字符串指针 (仅ASCII 0x20~0x7E有效)
 466           * 输出: 无
 467           * 说明: 小号ASCII字符显示, 每个字符宽5列+1列间距=6列,
 468           *       高8像素占1个page. 非ASCII字符自动跳过.
 469           *       边界: col+6 <= 128 才显示.
 470           */
 471          void show_str_5x7(uchar page, uchar col, uchar *buf)
 472          {
 473   1          uchar i = 0;
 474   1          ulong fontaddr;
 475   1          uchar  tmp[8];    /* 5x7 字符占5字节, 留余量 */
 476   1          uchar  k;
 477   1      
 478   1          /* 边界检查 */
 479   1          if (page < 1 || page > LCD_PAGES) return;
 480   1          if (col  < 1 || col  > LCD_WIDTH) return;
 481   1      
 482   1          while (buf[i] != 0)
 483   1          {
 484   2              if (buf[i] >= 0x20 && buf[i] <= 0x7E)
 485   2              {
 486   3                  /* 边界: 剩余列数 >= 6 (5数据列+1间距) 才显示 */
 487   3                  if (col > (LCD_WIDTH - 6 + 1)) break;
 488   3                  /* 地址计算: (char - 0x20) * 8 + ASCII5_BASE */
C51 COMPILER V9.59.0.0   D12864                                                            09/12/2026 21:49:23 PAGE 9   

 489   3                  fontaddr  = (ulong)(buf[i] - 0x20) * 8;
 490   3                  fontaddr += ASCII5_BASE;
 491   3                  rom_read_bytes(fontaddr, tmp, 5);       /* 读5字节点阵 */
 492   3                  lcd_address(page, col);
 493   3                  for (k = 0; k < 5; k++)
 494   3                      transfer_data_lcd(tmp[k]);          /* 竖置横排直接发送 */
 495   3                  transfer_data_lcd(0x00);                /* 1列间距 */
 496   3                  col += 6;
 497   3                  i   += 1;
 498   3              }
 499   2              else
 500   2              {
 501   3                  i++;   /* 非ASCII跳过 */
 502   3              }
 503   2          }
 504   1      }


