 255          /* ================= 字符串显示 ================= */
 256          /* 显示GB2312字符串(16x16汉字 / 8x16 ASCII) */
 257          void display_GB2312_string(uchar page, uchar column, uchar *text)
 258          {
 259   1          uchar i = 0;
 260   1          ulong fontaddr;
 261   1          while (text[i] > 0x00)
 262   1          {
 263   2              if (((text[i] >= 0xB0) && (text[i] <= 0xF7)) && (text[i + 1] >= 0xA1))
 264   2              {
 265   3                  /* GB2312 简体汉字地址: ((MSB-0xB0)*94 + (LSB-0xA1) + 846) * 32 */
 266   3                  fontaddr  = (text[i] - 0xB0) * 94;
 267   3                  fontaddr += (text[i + 1] - 0xA1) + 846;
 268   3                  fontaddr  = (ulong)(fontaddr * 32);
 269   3                  get_and_write_16x16(fontaddr, page, column);
 270   3                  i += 2;
 271   3                  column += 16;
 272   3              }
 273   2              else if (((text[i] >= 0xA1) && (text[i] <= 0xA3)) && (text[i + 1] >= 0xA1))
 274   2              {
 275   3                  /* GB2312 15x16 字符地址: ((MSB-0xA1)*94 + (LSB-0xA1)) * 32 */
 276   3                  fontaddr  = (text[i] - 0xA1) * 94;
 277   3                  fontaddr += (text[i + 1] - 0xA1);
 278   3                  fontaddr  = (ulong)(fontaddr * 32);
 279   3                  get_and_write_16x16(fontaddr, page, column);
 280   3                  i += 2;
 281   3                  column += 16;
 282   3              }
 283   2              else if ((text[i] >= 0x20) && (text[i] <= 0x7E))
 284   2              {
 285   3                  /* 8x16 ASCII 基址 0x3CF80 */
 286   3                  fontaddr  = (text[i] - 0x20);
 287   3                  fontaddr  = (ulong)(fontaddr * 16);
 288   3                  fontaddr  = (ulong)(fontaddr + 0x3CF80);
 289   3                  get_and_write_8x16(fontaddr, page, column);
 290   3                  i += 1;
 291   3                  column += 8;
 292   3              }
 293   2              else
 294   2              {
 295   3                  i++;
 296   3              }
 297   2          }
 298   1      }
