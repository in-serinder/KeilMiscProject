 195          /* 从字库IC读出16x16点阵并显示 */
 196          void get_and_write_16x16(ulong fontaddr, uchar page, uchar column)
 197          {
 198   1          uchar i, j, disp_data;
 199   1          ROM_CS = 0;
 200   1          send_command_to_ROM(0x03);
