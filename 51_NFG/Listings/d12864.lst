 324          /* ============================================================
 325           *  新增函数: 字库通用读取 + 三种字号字符串显示
 326           *  自查要点:
 327           *   - fontaddr 使用 unsigned long, 防止8位变量溢出
 328           *   - 16点阵汉字写连续2个page(page, page+1), 避免只显示半个
 329           *   - LCD SPI 引脚 (LCD_SCL/LCD_SDA) 与 字库ROM SPI 引脚
 330           *     (ROM_SCK/ROM_IN/ROM_OUT) 完全独立, 不共用
 331           *   - 字库读取使用指令 0x03, 24位地址顺序: 高8 -> 中8 -> 低8
 332           *   - 点阵竖置横排, 读取后直接送LCD, 不翻转字节
 333           *   - 边界判断: page 1~8, col 1~128, 超出则跳过该字符
 334           * ============================================================ */
 335          
 336          /*
 337           * 函数: rom_read_bytes
 338           * 输入: addr  - 字库ROM 24位起始地址 (unsigned long)
 339           *       buf   - 数据存放缓冲区指针
 340           *       n     - 读取字节数 (1~255)
 341           * 输出: 无 (数据写入 buf)
 342           * 说明: 从字库ROM指定24bit地址连续读取n个字节.
 343           *       使用SPI读指令 0x03, 地址发送顺序: 高8位->中8位->低8位.
 344           *       引脚: ROM_CS(P1.5), ROM_SCK(P1.4), ROM_IN(P1.2), ROM_OUT(P1.3)
 345           */
 346          void rom_read_bytes(ulong addr, uchar *buf, uchar n)
 347          {
 348   1          uchar i;
 349   1          send_command_to_ROM(0x03);                   /* 读数据指令 */
 350   1          send_command_to_ROM((uchar)((addr >> 16) & 0xFF));  /* 地址高8位 */
 351   1          send_command_to_ROM((uchar)((addr >> 8)  & 0xFF));  /* 地址中8位 */
 352   1          send_command_to_ROM((uchar)( addr        & 0xFF));  /* 地址低8位 */
 353   1          for (i = 0; i < n; i++)
 354   1          {
 355   2              buf[i] = get_data_from_ROM();
 356   2          }
 357   1      }
 358          
 359          /*
 360           * 函数: show_str_16x16
 361           * 输入: page - 起始页 (1~8, 因为汉字占2页, page最大为7)
 362           *       col  - 起始列 (1~128)
 363           *       buf  - 字符串指针 (GB2312编码, 含\0结束)
 364           * 输出: 无
C51 COMPILER V9.59.0.0   D12864                                                            10/12/2026 13:53:00 PAGE 7   

 365           * 说明: 显示15x16大号GB2312汉字 (占16列宽, 2个page).
 366           *       遇到ASCII字符(0x20~0x7E)自动切换为8x16点阵 (占8列宽).
 367           *       边界: page+1<=8 且 col+宽度<=128 才显示, 否则跳过.
 368           */
 369          void show_str_16x16(uchar page, uchar col, uchar *buf)
 370          {
 371   1          uchar i = 0;
 372   1          ulong fontaddr;
 373   1          uchar  tmp[32];    /* 最大16x16=32字节 */
 374   1          uchar  j, k;
 375   1      
 376   1          /* 起始页越界: 汉字需要2页, 所以 page 必须 <= 7 */
 377   1          if (page < 1 || page > (LCD_PAGES - 1)) return;
 378   1          if (col  < 1 || col  > LCD_WIDTH)       return;
 379   1      
 380   1          while (buf[i] != 0)
 381   1          {
 382   2              /* ---- GB2312 汉字 (16x16) ---- */
 383   2              if ((buf[i] >= 0xB0 && buf[i] <= 0xF7) && (buf[i+1] >= 0xA1))
 384   2              {
 385   3                  /* 边界: 剩余列数 >= 16 才显示 */
 386   3                  if (col > (LCD_WIDTH - 16 + 1)) break;
 387   3                  /* 地址计算: ((MSB-0xB0)*94 + (LSB-0xA1) + 846) * 32 */
 388   3                  fontaddr  = (ulong)(buf[i]   - 0xB0) * 94;
 389   3                  fontaddr += (ulong)(buf[i+1] - 0xA1) + GB16_OFFSET;
 390   3                  fontaddr *= 32;
 391   3                  rom_read_bytes(fontaddr, tmp, 32);      /* 读32字节点阵 */
 392   3                  /* 写2个连续page: page 和 page+1 */
 393   3                  for (j = 0; j < 2; j++)
 394   3                  {
 395   4                      lcd_address(page + j, col);
 396   4                      for (k = 0; k < 16; k++)
 397   4                      {
 398   5                          transfer_data_lcd(tmp[j * 16 + k]);  /* 竖置横排, 直接发送 */
 399   5                      }
 400   4                  }
 401   3                  col += 16;
 402   3                  i   += 2;
 403   3              }
 404   2              /* ---- GB2312 符号区 A1~A3 (16x16) ---- */
 405   2              else if ((buf[i] >= 0xA1 && buf[i] <= 0xA3) && (buf[i+1] >= 0xA1))
 406   2              {
 407   3                  if (col > (LCD_WIDTH - 16 + 1)) break;
 408   3                  fontaddr  = (ulong)(buf[i]   - 0xA1) * 94;
 409   3                  fontaddr += (ulong)(buf[i+1] - 0xA1);
 410   3                  fontaddr *= 32;
 411   3                  rom_read_bytes(fontaddr, tmp, 32);
 412   3                  for (j = 0; j < 2; j++)
 413   3                  {
 414   4                      lcd_address(page + j, col);
 415   4                      for (k = 0; k < 16; k++)
 416   4                          transfer_data_lcd(tmp[j * 16 + k]);
 417   4                  }
 418   3                  col += 16;
 419   3                  i   += 2;
 420   3              }
 421   2              /* ---- ASCII 自动切换 8x16 ---- */
 422   2              else if (buf[i] >= 0x20 && buf[i] <= 0x7E)
 423   2              {
 424   3                  if (col > (LCD_WIDTH - 8 + 1)) break;
 425   3                  fontaddr  = (ulong)(buf[i] - 0x20) * 16;
 426   3                  fontaddr += ASCII8_BASE;
C51 COMPILER V9.59.0.0   D12864                                                            10/12/2026 13:53:00 PAGE 8   

 427   3                  rom_read_bytes(fontaddr, tmp, 16);      /* 读16字节点阵 */
 428   3                  for (j = 0; j < 2; j++)
 429   3                  {
 430   4                      lcd_address(page + j, col);
 431   4                      for (k = 0; k < 8; k++)
 432   4                          transfer_data_lcd(tmp[j * 8 + k]);
 433   4                  }
 434   3                  col += 8;
 435   3                  i   += 1;
 436   3              }
 437   2              else
 438   2              {
 439   3                  i++;   /* 非法字符跳过 */
 440   3              }
 441   2          }
 442   1      }
