   1          #include "SN74HC165N.h"
   2          #include "SN74HC595N.h"   /* 需要 SR595_PL165() */
   3          
   4          /* 读取当前 OUT 引脚电平 (不产生 CLK) */
   5          static u8 rd_pin(u8 v)
   6          {
   7   1        return v ? 1 : 0;
   8   1      }
   9          
  10          static void clk_pulse(void)
  11          {
  12   1        CLK165 = 0;
  13   1        CLK165 = 1;
  14   1      }
  15          
  16          /* =========================================================================
  17           *  初始化: 引脚准备 (CLK 置低, OUT 引脚设为输入)
  18           *  STC90C58 的 P1/P2 上电默认为准双向口, 读取前先写 1 即可当输入使用。
  19           * ========================================================================= */
  20          void init_SN74HC165N(void)
  21          {
  22   1        CLK165    = 0;
  23   1      
  24   1        DQ_CTL_OUT = 1;   /* 准双向口, 置 1 作为输入 */
  25   1        AL_CTL_OUT = 1;
  26   1        AR_CTL_SER = 1;
  27   1      }
  28          
  29          /* =========================================================================
  30           *  PL 装载: 拉低装入并行数据, 再拉高进入移位模式
  31           *  三片 165 的 PL 共用, 由 595-CTL 的 QD 控制。
  32           * ========================================================================= */
  33          void SR165_Load(void)
  34          {
  35   1        SR595_PL165(0);   /* PL = 0, 并行装入 */
  36   1        /* 短延时确保装载完成 (此处用空操作, 时钟很慢足够) */
  37   1        SR595_PL165(1);   /* PL = 1, 进入移位 */
  38   1      }
  39          
  40          /* 读一位: 先读 OUT, 再 CLK 脉冲 */
  41          u8 SR165_ShiftReadBit(void)
  42          {
  43   1        u8 b;
  44   1        b = rd_pin(DQ_CTL_OUT);
  45   1        clk_pulse();
  46   1        return b;
  47   1      }
  48          
  49          /* =========================================================================
  50           *  读取 165-DQ 的 8 位 (DQ0-DQ7)
  51           *  165 移位输出顺序: 先出 H 位(D7) 还是 QA(D0) 取决于芯片 QH 接法。
  52           *  下面按"先出最高位 D7, 最后出 D0"的常见顺序组装 (QA->D0 ... QH->D7)。
  53           *  若实际接线相反, 只需把循环里的移位方向改成左移即可。
  54           * ========================================================================= */
C51 COMPILER V9.59.0.0   SN74HC165N                                                        10/06/2026 16:37:35 PAGE 2   

  55          u8 SR165_DQ_Read(void)
  56          {
  57   1        u8 i;
  58   1        u8 dat = 0;
  59   1      
  60   1        SR165_Load();                 /* 装载并行数据 */
  61   1      
  62   1        for (i = 0; i < 8; i++) {
  63   2          dat <<= 1;                  /* 先收到的位放在高位 */
  64   2          dat |= rd_pin(DQ_CTL_OUT);
  65   2          clk_pulse();
  66   2        }
  67   1        return dat;
  68   1      }
  69          
  70          /* =========================================================================
  71           *  读取 165-A12 两片级联的地址 (A0-A12)
  72           *
  73           *  两片 165 级联: 前级(AR)的 QH 串入末级(AL)的 SER;
  74           *  末级(AL) 的 QH 作为整链输出, 接到 MCU 的 AL_CTL_OUT。
  75           *  因此数据先经末级输出: 先读到的是"前级(AR)的 8 位 A0-A7",
  76           *  之后继续读到"末级(AL)的 A8-A12"。
  77           *  这里读 16 位(两片满) 再取低/高部分, 低 13 位有效 -> A0-A12。
  78           * ========================================================================= */
  79          u16 SR165_A12_Read(void)
  80          {
  81   1        u8  i;
  82   1        u16 dat = 0;
  83   1      
  84   1        SR165_Load();                 /* 装载并行数据 */
  85   1      
  86   1        /* 前级 8 位 (A0-A7) 先出 */
  87   1        for (i = 0; i < 8; i++) {
  88   2          dat <<= 1;
  89   2          dat |= rd_pin(AL_CTL_OUT);
  90   2          clk_pulse();
  91   2        }
  92   1        /* 末级 8 位 (其中 A8-A12 有效) 再出 */
  93   1        for (i = 0; i < 8; i++) {
  94   2          dat <<= 1;
  95   2          dat |= rd_pin(AL_CTL_OUT);
  96   2          clk_pulse();
  97   2        }
  98   1        return dat;
  99   1      }
 100          
 101          /* =========================================================================
 102           *  统一接口
 103           * ========================================================================= */
 104          u16 SR165_Read(u8 chip)
 105          {
 106   1        switch (chip) {
 107   2          case SR165_DQ:
 108   2            return (u16)SR165_DQ_Read();
 109   2          case SR165_A12:
 110   2            return SR165_A12_Read();
 111   2          default:
 112   2            return 0;
 113   2        }
 114   1      }
