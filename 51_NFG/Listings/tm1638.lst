 273          /* 读回 4 个原始字节（不做任何位映射），调试按键矩阵时用它 */
 274          void TM_ReadKeyBytes(unsigned char *buf)
 275          {
 276   1          unsigned char i;
 277   1      
 278   1          TM_Start();
 279   1          TM_SendByte(TM_CMD_READ_KEY);
 280   1          TM_DIO = 1; /* 交还总线 */
 281   1      
 282   1          for (i = 0; i < 4; i++)
 283   1              buf[i] = TM_ReadByte();
