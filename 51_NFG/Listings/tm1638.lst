 285   1          TM_Stop();
 286   1      }
 287          
 288          /* 4 字节原始数据 -> 8 位键值。
 289             字节 i = 第 i+1 列；两行分别取 TM_KEY_ROW1 / TM_KEY_ROW2（本模块是 bit0 与 bit4）。
 290             注意两个坑：
 291               - 不能按"顺序映射"，否则按 S1/S2/S3/S4 会错报成 S1/S3/S5/S7；
 292               - 第二行不是 bit1，按 bit1 解会让 S5~S8 完全读不到。 */
 293          unsigned char TM_KeysFromBytes(unsigned char *buf)
 294          {
 295   1          unsigned char i, key = 0;
 296   1      
 297   1          for (i = 0; i < 4; i++)
 298   1          {
 299   2              if (buf[i] & TM_KEY_ROW1)
 300   2                  key |= (unsigned char)(1 << i);
 301   2              if (buf[i] & TM_KEY_ROW2)
C51 COMPILER V9.59.0.0   TM1638                                                            11/14/2026 20:14:56 PAGE 6   

 302   2                  key |= (unsigned char)(1 << (i + 4));
 303   2          }
 304   1          return key;
 305   1      }
