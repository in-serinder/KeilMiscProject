 209          /* 只认 0-9 A-F 和 '-' '_' ' '，其余按空白处理 */
 210          void TM_ShowString(unsigned char *s)
 211          {
 212   1          unsigned char i, c;
 213   1      
 214   1          for (i = 0; i < TM_DIGITS; i++)
 215   1              s_ram[2 * i] = SEG_BLANK;
