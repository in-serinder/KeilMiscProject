 229   2              else if (c == '_')
 230   2                  s_ram[2 * i] = SEG_UNDERLINE;
 231   2              else
 232   2                  s_ram[2 * i] = SEG_BLANK;
 233   2              i++;
 234   2          }
 235   1          TM_Flush();
 236   1      }
