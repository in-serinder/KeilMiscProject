  28          uchar code line6[]      = "jumps over the lazy";
  29          uchar code line7[]      = "dog. 0123456789";
  30          uchar code line8[]      = "!@#$%^&*()_+-=[]{}";
  31          
  32          void main(void)
  33          {
  34   1          initial_lcd();
  35   1          clear_screen();
  36   1      
  37   1          while (1)
  38   1          {
  39   2              clear_screen();
  40   2      
  41   2              /* 第 1~2 页: 2 倍放大标题 (10x14, 每行 11 个字) */
  42   2              lcd_text_2x(1, 1, line_title);
  43   2      
