   1          #include "stc90c58.h"
   2          #include "Display\d12864.h"
   3          
   4          /*
   5           *  JLX12864G-08602 Ver4.0  128x64 点阵显示
   6           *  LCD 驱动: UC1701X (模拟 SPI, 引脚见 d12864.h)
   7           *
   8           *  两种出字方式, 开关在 Display/d12864.h, 8K Flash 只能二选一:
   9           *    USE_ASCII_FONT = 1 : 内置 5x7 ASCII 点阵, 不依赖模块字库 IC  (当前配置)
  10           *    USE_FONT_ROM   = 1 : 走模块上的 25Q80 字库 IC, 可显示 16x16 汉字
  11           *
  12           *  硬件接线:
  13           *    LCD:  CS=P3.7  RST=P3.6  AO=P3.5  LEDA=P3.4  SDA=P2.6  SCL=P2.5   正常
  14           *    ROM:  SI=P2.7  SO=P0.6   SCK=P0.5  (R2/R4 各 5.1k 上拉到 +5V)     正常
  15           *    ROM:  CS#= 模块第4脚, 板上直接接地, MCU 无连线                     << 缺这一根
  16           */
  17          
  18          #if USE_ASCII_FONT
  19          
  20          /* ---- 演示文本 (纯 ASCII) ---- */
  21          uchar code line_title[] = "HELLO WORLD";
  22          uchar code line1[]      = "8051 + 12864 LCD";
