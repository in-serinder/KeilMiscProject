   1          #include "stc90c58.h"
   2          #include "AS6C622_Serial.h"
   3          #include "SN74HC595N.h"
   4          #include "SN74HC165N.h"
   5          #include "uart.h"
   6          #include "delay.h"
   7          
   8          /* =========================================================================
   9           *  165 实时位响应诊断程序
  10           *
  11           *  目的: 不依赖 AS6C622, 直接观察三片 165 读回的真实电平, 便于你用镊子/
  12           *        导线短接某个引脚到 GND(), 立刻看到对应位在串口上变化。
  13           *
  14           *  三片 165 (各自独立或级联均可, 本程序分别读三个 GPIO):
  15           *    165#1 采集 DQ0-DQ7    QH7 -> P2.1  (DQ_CTL_OUT)
  16           *    165#2 采集 A0-A7      QH7 -> P1.6  (AR_CTL_SER)
  17           *    165#3 采集 A8-A12     QH7 -> P1.7  (AL_CTL_OUT)
  18           *
  19           *  输出格式 (约每 0.5s 刷新一次):
  20           *    DQ=P21:11111111  A0_7=P16:11111111  A8_12=P17:11111111
  21           *
  22           *  判读:
  23           *    - 短接某个 165#1 的 Dn 到 GND  -> DQ 那一列对应位应变 0
  24           *    - 短接 165#1 的 QH(pin9) 到 GND -> DQ 那一列应全部变 0 (00000000)
  25           *    若短接引脚后某一列毫无变化, 说明 MCU 该引脚与对应 165 的 QH 没接通。
  26           * ========================================================================= */
  27          
  28          /* 直接读一个 165 的 8 位原始数据 (从指定引脚)
  29           * 165 装载后 QH 先输出 bit7, 每个 CLK 输出下一位, 所以先读的放高位 */
  30          static u8 rd_165_pin(u8 pin)
  31          {
  32   1        u8 i;
  33   1        u8 dat = 0;
  34   1      
  35   1        for (i = 0; i < 8; i++) {
  36   2          dat <<= 1;
  37   2          dat |= (pin ? 1 : 0);
  38   2          /* CLK 脉冲: P2.0 (三片 165 共享) */
  39   2          CLK165 = 0;
  40   2          CLK165 = 1;
  41   2        }
  42   1        return dat;
  43   1      }
  44          
  45          /* 打印 8 位二进制 */
  46          static void UART_Bin8(u8 v)
  47          {
  48   1        u8 i;
  49   1        for (i = 0; i < 8; i++) {
  50   2          UART_SendByte((v & 0x80) ? '1' : '0');
  51   2          v <<= 1;
  52   2        }
  53   1      }
  54          
C51 COMPILER V9.59.0.0   MAIN                                                              10/06/2026 17:54:22 PAGE 2   

  55          /* 打印 16 位二进制 */
  56          static void UART_Bin16(u16 v)
  57          {
  58   1        UART_Bin8((u8)(v >> 8));
  59   1        UART_Bin8((u8)(v & 0xFF));
  60   1      }
  61          
  62          void main(void)
  63          {
  64   1        u8 dq, a07, a812;
  65   1        u16 cnt = 0;
  66   1      
  67   1        AS6C622_Init();    /* 初始化 595/165 及 RAM 空闲态 */
  68   1        UART_Init();       /* 初始化串口 115200@22.061MHz(12T) */
  69   1      
  70   1        UART_SendString((uint8_t *)"\r\n=== 165 real-time bit monitor ===\r\n");
  71   1        UART_SendString((uint8_t *)"short a pin to GND, watch the column change\r\n");
  72   1        UART_SendString((uint8_t *)"DQ=P21  A0_7=P16  A8_12=P17\r\n\r\n");
  73   1      
  74   1        /* 让 595-DQ 驱动总线为 0x00, 并让 RAM 不选中(不干扰总线),
  75   1         * 这样 165#1 采集到的应该是 595-DQ 输出的 0x00 (如果链路正常)。
  76   1         * 你也可以把 595-DQ 输出改成 0xFF 观察。 */
  77   1        SR595_RAM_OE(0);   /* RAM 不驱动 */
  78   1        SR595_RAM_CE(0);   /* RAM 不选中 */
  79   1        SR595_DQ_OE(1);    /* 595-DQ 输出使能, 驱动 DQ 总线 */
  80   1        SR595_DQ_Write(0x00);
  81   1      
  82   1        /* P1.6 / P1.7 / P2.1 设为输入(准双向口读前先写 1) */
  83   1        AR_CTL_SER = 1;
  84   1        AL_CTL_OUT = 1;
  85   1        DQ_CTL_OUT = 1;
  86   1      
  87   1        while (1) {
  88   2          /* PL 脉冲: 三片同时锁存当前总线电平 (PL 由 595-CTL 的 QD 控制) */
  89   2          SR595_PL165(0);
  90   2          SR595_PL165(1);
  91   2      
  92   2          /* 分别读三片 165 (每片读 8 位, 共享 CLK) */
  93   2          dq   = rd_165_pin(DQ_CTL_OUT);   /* P2.1 */
  94   2          a07  = rd_165_pin(AR_CTL_SER);   /* P1.6 */
  95   2          a812 = rd_165_pin(AL_CTL_OUT);   /* P1.7 */
  96   2      
  97   2          /* 打印 */
  98   2          UART_SendString((uint8_t *)"DQ =");
  99   2          UART_Bin8(dq);
 100   2          UART_SendString((uint8_t *)"  A07=");
 101   2          UART_Bin8(a07);
 102   2          UART_SendString((uint8_t *)"  A8_12=");
 103   2          UART_Bin8(a812);
 104   2          UART_SendString((uint8_t *)"\r\n");
 105   2      
 106   2          cnt++;
 107   2          delay_ms(500);
 108   2      
 109   2          /* 每约 5 秒换一次 595-DQ 总线电平, 便于观察总线是否被 165 采到
 110   2           * (若 '===' 行出现则说明串口活着) */
 111   2          if ((cnt % 10) == 0) {
 112   3            UART_SendString((uint8_t *)"--- toggle bus ---\r\n");
 113   3            SR595_DQ_Write(0xFF);
 114   3          } else if ((cnt % 10) == 5) {
 115   3            SR595_DQ_Write(0x00);
 116   3          }
