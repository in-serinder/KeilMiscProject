   8          /* =========================================================================
   9           *  165 实时位响应诊断程序
  10           *
  11           *  目的: 不依赖 AS6C622, 直接观察三片 165 读回的真实电平, 便于你用镊子/
  12           *        导线短接某个引脚到 GND(), 立刻看到对应位在串口上变化。
  13           *
  14           *  三片 165 (各自独立或级联均可, 本程序分别读三个 GPIO):
  15           *    165#1 采集 DQ0-DQ7    QH7 -> P2.1  (DQ_CTL_OUT)
  16           *    165#2 采集 A0-A7      QH7 -> P1.6  (AR_CTL_SER)
  17           *    165#3 采集 A8-A12     QH7 -> P1.7  (AL_CTL_OUT)
  18           *
  19           *  输出格式 (约每 0.5s 刷新一次):
  20           *    DQ=P21:11111111  A0_7=P16:11111111  A8_12=P17:11111111
  21           *
  22           *  判读:
  23           *    - 短接某个 165#1 的 Dn 到 GND  -> DQ 那一列对应位应变 0
  24           *    - 短接 165#1 的 QH(pin9) 到 GND -> DQ 那一列应全部变 0 (00000000)
  25           *    若短接引脚后某一列毫无变化, 说明 MCU 该引脚与对应 165 的 QH 没接通。
  26           * ========================================================================= */
  27          
  28          /* 直接读一个 165 的 8 位原始数据 (从指定引脚)
  29           * 165 装载后 QH 先输出 bit7, 每个 CLK 输出下一位, 所以先读的放高位 */
  30          static u8 rd_165_pin(u8 pin)
  31          {
  32   1        u8 i;
  33   1        u8 dat = 0;
  34   1      
  35   1        for (i = 0; i < 8; i++) {
  36   2          dat <<= 1;
  37   2          dat |= (pin ? 1 : 0);
  38   2          /* CLK 脉冲: P2.0 (三片 165 共享) */
  39   2          CLK165 = 0;
  40   2          CLK165 = 1;
  41   2        }
  42   1        return dat;
  43   1      }
  44          
  45          /* 打印 8 位二进制 */
  46          static void UART_Bin8(u8 v)
  47          {
  48   1        u8 i;
  49   1        for (i = 0; i < 8; i++) {
  50   2          UART_SendByte((v & 0x80) ? '1' : '0');
  51   2          v <<= 1;
  52   2        }
  53   1      }
  54          
C51 COMPILER V9.59.0.0   MAIN                                                              10/07/2026 20:35:19 PAGE 2   

  55          /* 打印 16 位二进制 */
  56          static void UART_Bin16(u16 v)
  57          {
  58   1        UART_Bin8((u8)(v >> 8));
  59   1        UART_Bin8((u8)(v & 0xFF));
  60   1      }
