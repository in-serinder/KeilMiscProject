   1          #include "uart.h"
   2          
   3          // 串口初始化: UART1, 115200bps @ 22.061MHz 晶振, 12T(单倍速)模式
   4          //   STC90C58RD+ 实测为 12T 模式, 经典 8051 波特率发生器用定时器1(模式2)
   5          //   + SMOD=1(波特率加倍):
   6          //       Baud = 2^SMOD / 32 * SYSclk / (12 * (256 - TH1))
   7          //   令 256 - TH1 = 1  (TH1 = 0xFF):
   8          //       Baud = 2 * 22061000 / (32 * 12 * 1) = 114901  (误差 -0.26%, 可用)
   9          //   注: 22.061MHz 在 12T 下无法精确得到 115200, 这是最接近的档位。
  10          void UART_Init(void) // 约 115200bps@22.061MHz(12T), 实测约 114901
  11          {
  12   1        SCON  = 0x50;      // 8位数据, 可变波特率, 模式1
  13   1        PCON |= 0x80;      // SMOD = 1 (波特率加倍) —— 关键
  14   1        TMOD &= 0x0F;      // 清 Timer1 控制位 (保留 Timer0)
  15   1        TMOD |= 0x20;      // 定时器1 模式2 (8位自动重装)
  16   1        TH1 = 0xFF;        // 重装值 (256-1=255)
  17   1        TL1 = 0xFF;        // 初值
  18   1        ET1 = 0;           // 禁止 Timer1 中断
  19   1        TR1 = 1;           // 启动 Timer1
  20   1      }
  21          
  22          // 发送一个字节
  23          void UART_SendByte(uint8_t byte) {
  24   1        SBUF = byte;
  25   1        while (!TI)
  26   1          ;
  27   1        TI = 0;
  28   1      }
  29          
  30          // 发送字符串
  31          void UART_SendString(uint8_t *str) {
  32   1        while (*str) {
  33   2          UART_SendByte(*str++);
  34   2        }
  35   1      }
  36          
  37          // 发送十六进制数
  38          void UART_SendHex(uint8_t byte) {
  39   1        uint8_t high, low;
  40   1        high = byte >> 4;
  41   1        low = byte & 0x0F;
  42   1      
  43   1        // 发送高位
  44   1        if (high < 10)
  45   1          UART_SendByte('0' + high);
  46   1        else
  47   1          UART_SendByte('A' + (high - 10));
  48   1      
  49   1        // 发送低位
  50   1        if (low < 10)
  51   1          UART_SendByte('0' + low);
  52   1        else
  53   1          UART_SendByte('A' + (low - 10));
  54   1      }
