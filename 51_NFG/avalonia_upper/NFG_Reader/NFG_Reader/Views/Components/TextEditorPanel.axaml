<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
             x:Class="NFG_Reader.Views.Components.TextEditorPanel"
             x:Name="Root">

    <!-- Reusable rich-text panel: editable/read-only text box + compact footer.
    Left footer slot  -> optional encoding drop-down (borderless) + export button.
    Right footer slot -> character count + active encoding caption. -->
    <Border Background="White"
            BorderBrush="{StaticResource NfgBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid RowDefinitions="*, Auto">

            <TextBox Grid.Row="0"
                     Classes="nfg"
                     Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                     IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontSize="11"
                     BorderThickness="0"
                     CornerRadius="0"
                     Background="Transparent"
                     VerticalContentAlignment="Top"
                     Padding="8,6" />

            <Border Grid.Row="1"
                    Background="{StaticResource NfgSurfaceBrush}"
                    BorderBrush="{StaticResource NfgBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="6,3">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Left: encoding selector (borderless) + export button -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowEncodingBar, ElementName=Root}">
                        <ComboBox Classes="nfg"
                                  MinHeight="22"
                                  Padding="6,0"
                                  FontSize="10"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ItemsSource="{Binding Encodings, ElementName=Root}"
                                  SelectedItem="{Binding SelectedEncoding, ElementName=Root, Mode=TwoWay}" />
                        <Button Classes="nfg ghost"
                                FontSize="10"
                                Padding="8,2"
                                MinHeight="20"
                                IsVisible="{Binding ShowDownload, ElementName=Root}"
                                Content="Download .txt"
                                Command="{Binding SaveAsTxtCommand, ElementName=Root}" />
                    </StackPanel>

                    <!-- Right: captions -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Classes="caption" Text="{Binding EncodingCaption, ElementName=Root}" />
                        <TextBlock Classes="caption" Text="{Binding CountText, ElementName=Root}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

